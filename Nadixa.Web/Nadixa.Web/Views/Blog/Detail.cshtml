@model Nadixa.Web.Models.ViewModels.BlogDetailViewModel


@{
    ViewData["Title"] = "Blog Detail";
}

<!-- Content page -->
<section class="bg0 p-t-52 p-b-20" style="margin-top: 80px">
	<div class="container">
		@if (User.IsInRole("Admin"))
		{
			<div class="d-flex justify-content-end mb-4">
				<a class="btn mx-2 hov-btn3 text-white my-3" style="background-color:rgb(113, 127, 224);" asp-controller="Blog" asp-action="Edit" asp-route-id="@Model.Blog.Id">Edit Blog</a>
				<button class="btn btn-danger mx-2 hov-btn3 my-3 delete-blog-btn" data-blog-title="@Model.Blog.Title">Delete Blog</button>
			</div>
		}
		<div class="row">
			
			<div class="col-md-8 col-lg-9 p-b-80">
				<div class="p-r-45 p-r-0-lg">
					<!--  -->
					<div class="wrap-pic-w how-pos5-parent">
						<img src="@Model.Blog.ImageUrl" alt="IMG-BLOG">

						<div class="flex-col-c-m size-123 bg9 how-pos5">
							<span class="ltext-107 cl2 txt-center">
                                @Model.Blog.CreateAt.Date.Day
							</span>

							<span class="stext-109 cl3 txt-center">
                                @Model.Blog.CreateAt.Date.ToString("MMM yyyy")
							</span>
						</div>
					</div>

					<div class="p-t-32">
						<span class="flex-w flex-m stext-111 cl2 p-b-19">
							<span>
								<span class="cl4">By</span> Admin
								<span class="cl12 m-l-4 m-r-6">|</span>
							</span>

							<span>
                                @Model.Blog.CreateAt.Date.Day @Model.Blog.CreateAt.Date.ToString("MMM"), @Model.Blog.CreateAt.Date.ToString("yyyy")
								<span class="cl12 m-l-4 m-r-6">|</span>
							</span>

							<span>
                                @Model.Blog.Category
								<span class="cl12 m-l-4 m-r-6">|</span>
							</span>

							<span>
								@Model.Blog.Comments.Count Comments
							</span>
						</span>

						<h4 class="ltext-109 cl2 p-b-28">
                            @Model.Blog.Title
						</h4>

						<p class="stext-117 cl6 p-b-26">
                            @Model.Blog.Content
						</p>

						<p class="stext-117 cl6 p-b-26">
							Praesent vel mi bibendum, finibus leo ac, condimentum arcu. Pellentesque sem ex, tristique sit amet suscipit in, mattis imperdiet enim. Integer tempus justo nec velit fringilla, eget eleifend neque blandit. Sed tempor magna sed congue auctor. Mauris eu turpis eget tortor ultricies elementum. Phasellus vel placerat orci, a venenatis justo. Phasellus faucibus venenatis nisl vitae vestibulum. Praesent id nibh arcu. Vivamus sagittis accumsan felis, quis vulputate
						</p>
					</div>

					<div class="flex-w flex-t p-t-16 p-b-22">
						<span class="size-216 stext-116 cl8 p-t-4">
							Tags
						</span>

						<div class="flex-w size-217">
							<a href="#" class="flex-c-m stext-107 cl6 size-301 bor7 p-lr-15 hov-tag1 trans-04 m-r-5 m-b-5">
								Streetstyle
							</a>

							<a href="#" class="flex-c-m stext-107 cl6 size-301 bor7 p-lr-15 hov-tag1 trans-04 m-r-5 m-b-5">
								Crafts
							</a>
						</div>
					</div>

					@if (Model.Blog.Comments.Any())
					{
						<div class="p-b-40">
							<h4 class="mtext-112 cl2 p-b-20">
								Comments (@Model.Blog.Comments.Count)
							</h4>
							@foreach(var comment in Model.Blog.Comments.OrderByDescending(c => c.CreatedAt))
							{
								<div class="bor19 p-3 m-b-20 comment-card" data-comment-id="@comment.Id" ">
									<div class="d-flex justify-content-between align-items-center mb-2">
										<strong>
                                            @comment.AuthorName 
											
										</strong>
										<small class="text-muted">
											@comment.CreatedAt.ToString("dd MMM yyyy")
										</small>
										@if (User.IsInRole("Admin") || comment.AuthorId == ViewBag.CurrentUserId)
										{
											<button type="button"
													class="delete-comment-btn btn btn-sm text-danger border-0 bg-transparent p-0"
													data-comment-id="@comment.Id">
												<i class="fa fa-trash"></i>
											</button>
										}
									</div>
									<p class="mb-0">
										@comment.Content
									</p>
								</div>
							}
						</div>
					}
					<!--  -->
					<div class="p-t-40">
						<h5 class="mtext-113 cl2 p-b-12">
							Leave a Comment
						</h5>

						<p class="stext-107 cl6 p-b-40">
							Your email address will not be published. Required fields are marked *
						</p>

						@if (User.Identity.IsAuthenticated)
						{
							<form asp-action="AddComment" asp-controller="Blog" method="post">
								<input type="hidden" name="blogId" value="@Model.Blog.Id"/>

								<div class="bor19 m-b-20">
									<textarea class="stext-111 cl2 plh3 size-124 p-lr-18 p-tb-15" name="content" placeholder="Comment..."></textarea>
								</div>

							
								<button class="flex-c-m stext-101 cl0 size-125 bg3 bor2 hov-btn3 p-lr-15 trans-04" type="submit">
									Post Comment
								</button>
							</form>
						}
						else
						{
							<p class="text-muted">You need to <a asp-controller="Auth" asp-action="Login" style="color:#717fe0">Login</a> to comment</p>
						}

					</div>
				</div>
			</div>

            <!-- SIDEBAR -->
            <div class="col-md-4 col-lg-3 p-b-80">
                <div class="side-menu">

                    <!-- Search -->
                    <div class="bor17 of-hidden pos-relative">
                        <input class="stext-103 cl2 plh4 size-116 p-l-28 p-r-55"
                               type="text" placeholder="Search">

                        <button class="flex-c-m size-122 ab-t-r fs-18 cl4 hov-cl1 trans-04">
                            <i class="zmdi zmdi-search"></i>
                        </button>
                    </div>

                    <!-- Categories -->
                    <div class="p-t-55">
                        <h4 class="mtext-112 cl2 p-b-33">
                            Categories
                        </h4>

                        <ul>
                            <li class="bor18">
                                <a asp-controller="Blog"
                                   asp-action="Index"
                                   class="dis-block stext-115 cl6 hov-cl1 trans-04 p-tb-8 p-lr-4">

                                    All Blogs
                                </a>
                            </li>
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var cat in ViewBag.Categories)
                                {
                                    <li class="bor18">
                                        <a asp-controller="Blog" asp-action="Index" asp-route-categoryId="@cat.Id" class="dis-block stext-115 cl6 hov-cl1 trans-04 p-tb-8 p-lr-4">
                                            @cat.Name
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                    </div>

                    <!-- Featured (static مؤقتًا) -->
                    <div class="p-t-65">
                        <h4 class="mtext-112 cl2 p-b-33">
                            Featured Products
                        </h4>

                        <ul>
                            <li class="flex-w flex-t p-b-30">
                                <div class="size-215 flex-col-t p-t-8">
                                    <span class="stext-116 cl8">
                                        Coming Soon...
                                    </span>
                                </div>
                            </li>
                        </ul>
                    </div>

                    <!-- Tags -->
                    <div class="p-t-50">
                        <h4 class="mtext-112 cl2 p-b-27">
                            Tags
                        </h4>

                        <div class="flex-w m-r--5">
                            <a href="#" class="flex-c-m stext-107 cl6 size-301 bor7 p-lr-15 hov-tag1 trans-04 m-r-5 m-b-5">
                                Bags
                            </a>

                            <a href="#" class="flex-c-m stext-107 cl6 size-301 bor7 p-lr-15 hov-tag1 trans-04 m-r-5 m-b-5">
                                Fashion
                            </a>

                            <a href="#" class="flex-c-m stext-107 cl6 size-301 bor7 p-lr-15 hov-tag1 trans-04 m-r-5 m-b-5">
                                Style
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
	</div>

	<form id="deleteBlogForm"
		  asp-controller="Blog"
		  asp-action="DeleteConfirmed"
		  asp-route-id="@Model.Blog.Id"
		  method="post">
	</form>
	

</section>

