

@model Nadixa.Web.Models.ViewModels.BlogCreateViewModel

@{
    ViewData["Title"] = "Create Blog";
}

<style>
    .image-preview-container{
        width: 100%;
        text-align: center;
    }

    .image-preview-container img{
        width: 80%;
        height: auto;
        object-fit: cover;
    }

</style>

<div class="container py-5" style="margin-top:70px">

    <div class="card shadow p-4">
        <h3 class="mb-4">Create New Blog</h3>

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <!-- Title -->
            <div class="mb-3">
                <label asp-for="Title" class="form-label required"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="BlogCategoryId" class="form-label fw-semibold required">Blog Category</label>

                <select asp-for="BlogCategoryId"
                        asp-items="Model.Categories"
                        class="form-select js-select2">
                    <option value="">Select Category</option>
                </select>

                <span asp-validation-for="BlogCategoryId" class="text-danger"></span>
            </div>

            <!-- Image -->
            <div class="mb-3">
                <label class="form-label required">Image</label>
                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" onchange="previewImage(event)"/>
                <div class="image-preview-container">
                    <img id="imagePreview"
                         src="https://via.placeholder.com/550x350?text=Preview"
                         class="rounded-4 border shadow-sm mt-3" />

                </div>
                <span asp-validation-for="ImageFile" class="text-danger"></span>
                @* <img id="imagePreview"
                     src="https://via.placeholder.com/550x350?text=Preview"
                     class="img-fluid rounded-4 border shadow-sm mt-3"
                     style="width:100%; max-height:400px; object-fit:cover;" /> *@
            </div>

            <!-- Content -->
            <div class="mb-3">
                <label asp-for="ShortDescription" class="form-label required">Description</label>
                <textarea asp-for="ShortDescription" class="form-control" rows="4"></textarea>
                <span asp-validation-for="ShortDescription" class="text-danger"></span>
            </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-end">
                <button type="submit" class="flex-c-m stext-101 cl0 size-103 bg1 bor1 hov-btn3 p-lr-15 trans-04">
                Create Blog
            </button>
            </div>
            

        </form>
    </div>

</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            console.log("Select2 loaded"); // 👈 اختبار

            $('.js-select2').select2({
                placeholder: "Select a category",
                allowClear: true,
                width: '100%'
            });
        });

                function previewImage(event) {
            const file = event.target.files[0];

            if (!file) return;

            // تأكد إنه صورة
            if (!file.type.startsWith("image/")) {
                alert("Please select a valid image file.");
                return;
            }

            const reader = new FileReader();

            reader.onload = function (e) {
                document.getElementById("imagePreview").src = e.target.result;
            };

            reader.readAsDataURL(file);
        }
    </script>
}