@model List<Nadixa.Web.Models.ViewModels.BlogViewModel>


@{
    ViewData["Title"] = "Blog";
}

<section class="bg-img1 txt-center p-lr-15 p-tb-92" style="background-image: url('/images/bg-02.jpg');  margin-top: 80px">
    <h2 class="ltext-105 cl0 txt-center">
        Blog
    </h2>
</section>

<!-- Content page -->
<section class="bg0 p-t-62 p-b-60">
    <div class="container">
        <div class="row">

            <!-- BLOG LIST -->
            <div class="col-md-8 col-lg-9 p-b-80">
                <div class="p-r-45 p-r-0-lg">

                    @foreach (var blog in Model)
                    {
                        <div class="p-b-63">
                            <a asp-controller="Blog" asp-action="Detail" asp-route-id="@blog.Id"
                               class="hov-img0 how-pos5-parent">

                                <img src="@blog.ImageUrl" alt="IMG-BLOG">

                                <div class="flex-col-c-m size-123 bg9 how-pos5">
                                    <span class="ltext-107 cl2 txt-center">
                                        @blog.Date.Day
                                    </span>

                                    <span class="stext-109 cl3 txt-center">
                                        @blog.Date.ToString("MMM yyyy")
                                    </span>
                                </div>
                            </a>

                            <div class="p-t-32">
                                <h4 class="p-b-15">
                                    <a asp-controller="Blog" asp-action="Detail" asp-route-id="@blog.Id"
                                       class="ltext-108 cl2 hov-cl1 trans-04">
                                        @blog.Title
                                    </a>
                                </h4>

                                <p class="stext-117 cl6">
                                    @blog.ShortDescription
                                </p>

                                <div class="flex-w flex-sb-m p-t-18">
                                    <span class="flex-w flex-m stext-111 cl2 p-r-30 m-tb-10">

                                        <span>
                                            <span class="cl4">By</span> @blog.Author
                                            <span class="cl12 m-l-4 m-r-6">|</span>
                                        </span>

                                        <span>
                                            @blog.Category
                                            <span class="cl12 m-l-4 m-r-6">|</span>
                                        </span>

                                        <span>
                                            0 Comments
                                        </span>

                                    </span>

                                    <a asp-controller="Blog" asp-action="Detail" asp-route-id="@blog.Id"
                                       class="stext-101 cl2 hov-cl1 trans-04 m-tb-10">
                                        Continue Reading
                                        <i class="fa fa-long-arrow-right m-l-9"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Pagination (static دلوقتي) -->
                    <div class="flex-l-m flex-w w-full p-t-10 m-lr--7">
                        <a href="#" class="flex-c-m how-pagination1 trans-04 m-all-7 active-pagination1">1</a>
                        <a href="#" class="flex-c-m how-pagination1 trans-04 m-all-7">2</a>
                    </div>

                </div>
            </div>

            <!-- SIDEBAR -->
            <div class="col-md-4 col-lg-3 p-b-80">
                <div class="side-menu">

                    <!-- Search -->
                    <div class="bor17 of-hidden pos-relative">
                        <input class="stext-103 cl2 plh4 size-116 p-l-28 p-r-55"
                               type="text" placeholder="Search">

                        <button class="flex-c-m size-122 ab-t-r fs-18 cl4 hov-cl1 trans-04">
                            <i class="zmdi zmdi-search"></i>
                        </button>
                    </div>

                    <!-- Categories -->
                    <div class="p-t-55">
                        <h4 class="mtext-112 cl2 p-b-33">
                            Categories
                        </h4>

                        <ul>
                            <li class="bor18">
                                <a asp-controller="Blog"
                                   asp-action="Index"
                                   class="dis-block stext-115 cl6 hov-cl1 trans-04 p-tb-8 p-lr-4">

                                    All Blogs
                                </a>
                            </li>
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var cat in ViewBag.Categories)
                                {
                                    <li class="bor18">
                                        <a asp-controller="Blog" asp-action="Index" asp-route-categoryId="@cat.Id" class="dis-block stext-115 cl6 hov-cl1 trans-04 p-tb-8 p-lr-4">
                                            @cat.Name
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                    </div>

                    <!-- Featured (static مؤقتًا) -->
                    <div class="p-t-65">
                        <h4 class="mtext-112 cl2 p-b-33">
                            Featured Products
                        </h4>

                        <ul>
                            <li class="flex-w flex-t p-b-30">
                                <div class="size-215 flex-col-t p-t-8">
                                    <span class="stext-116 cl8">
                                        Coming Soon...
                                    </span>
                                </div>
                            </li>
                        </ul>
                    </div>

                    <!-- Tags -->
                    <div class="p-t-50">
                        <h4 class="mtext-112 cl2 p-b-27">
                            Tags
                        </h4>

                        <div class="flex-w m-r--5">
                            <a href="#" class="flex-c-m stext-107 cl6 size-301 bor7 p-lr-15 hov-tag1 trans-04 m-r-5 m-b-5">
                                Bags
                            </a>

                            <a href="#" class="flex-c-m stext-107 cl6 size-301 bor7 p-lr-15 hov-tag1 trans-04 m-r-5 m-b-5">
                                Fashion
                            </a>

                            <a href="#" class="flex-c-m stext-107 cl6 size-301 bor7 p-lr-15 hov-tag1 trans-04 m-r-5 m-b-5">
                                Style
                            </a>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>