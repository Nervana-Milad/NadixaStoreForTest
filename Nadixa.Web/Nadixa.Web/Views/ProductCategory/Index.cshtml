@model List<Nadixa.Web.Models.ViewModels.ProductCategoryViewModel>

@{
    ViewData["Title"] = "Categories";
}

<div class="container py-5 categories-page">

    <!-- HEADER -->
    <div class="page-header d-flex justify-content-between align-items-center mb-5">
        <div>
            <span class="page-eyebrow">
                STORE MANAGEMENT
            </span>

            <h2 class="page-title mb-2">
                Product Categories
            </h2>

            <p class="page-subtitle mb-0">
                Organize your products into clear and attractive categories.
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create"
               class="add-category-btn">
                <i class="bi bi-plus-lg"></i>
                <span>Add Category</span>
            </a>
        }

    </div>


    <!-- EMPTY STATE -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="bi bi-grid"></i>
            </div>

            <h4>No Categories Yet</h4>

            <p>
                Start organizing your store by creating your first product category.
            </p>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create"
                   class="add-category-btn mt-3">
                    <i class="bi bi-plus-lg"></i>
                    Add Category
                </a>
            }
        </div>
    }
    else
    {
        <!-- CATEGORIES GRID -->
        <div class="row g-4">

            @foreach (var category in Model)
            {
                <div class="col-md-6 col-xl-4">

                    <div class="category-card">

                        <!-- IMAGE -->
                        <div class="category-image-wrapper">

                            <img src="@Url.Content(category.ImageUrl)"
                                 alt="@category.Name"
                                 class="category-image" />

                            <div class="category-image-overlay"></div>

                            @if (User.IsInRole("Admin"))
                            {
                                <!-- ADMIN ACTIONS -->
                                <div class="category-actions">

                                    <a asp-action="Edit"
                                       asp-route-id="@category.Id"
                                       class="category-action edit-action"
                                       title="Edit Category">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <button type="button"
                                            class="category-action delete-action delete-category-btn"
                                            data-category-id="@category.Id"
                                            data-category-name="@category.Name"
                                            title="Delete Category">
                                        <i class="bi bi-trash3"></i>
                                    </button>

                                </div>
                            }

                            <!-- CATEGORY LINK -->
                            <a asp-controller="Product"
                               asp-action="Index"
                               asp-route-categoryId="@category.Id"
                               class="category-shop-link">

                                <span>Shop Now</span>

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>


                        <!-- CONTENT -->
                        <div class="category-content">

                            <h4 class="category-name">
                                @category.Name
                            </h4>

                            <p class="category-description">
                                @(string.IsNullOrWhiteSpace(category.Description)
                                                        ? "Explore products in this category."
                                                        : category.Description)
                            </p>


                            <a asp-controller="Product"
                                asp-action="Index"
                                asp-route-categoryId="@category.Id"
                                class="category-view-link">
                                View Products
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
                }
        </div>

        <!-- DELETE FORM -->
        <form id="deleteCategoryForm" method="post">
            @Html.AntiForgeryToken()
        </form>
    }

</div>