@model List<Nadixa.Web.Models.ViewModels.ProductCategoryViewModel>

@{
    ViewData["Title"] = "Categories";
}

<style>
    /* SIDE ACTIONS */
    .category-side-actions {
        position: absolute;
        right: 15px;
        bottom: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        z-index: 20;
        opacity: 0;
        transform: translateX(20px);
        transition: 0.35s ease;
    }

    /* SHOW ON HOVER */
    .block1:hover .category-side-actions {
        opacity: 1;
        transform: translateX(0);
    }

    /* BUTTON */
    .side-action-btn {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        background: rgba(255,255,255,0.95);
        color: #111;
        box-shadow: 0 4px 15px rgba(0,0,0,.15);
        transition: 0.3s ease;
    }

        /* HOVER EFFECT */
        .side-action-btn:hover {
            transform: scale(1.1);
        }

    /* EDIT */
    .edit-btn:hover {
        background: #717fe0;
        color: #fff;
    }

    /* DELETE */
    .delete-btn:hover {
        background: #f74877;
        color: #fff;
    }
</style>

<div class="container py-5" style="margin-top:100px">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center">

        <div>
            <h2 class="fw-bold mb-1">
                Product Categories
            </h2>

            <p class="text-muted mb-0">
                Manage your store categories
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <div class="flex-c-m stext-106 cl6 size-105 bor4 pointer hov-btn3 trans-04 m-tb-4 px-3" style="background-color:#6c7ae0; color:white">
                <i class="icon-search cl2 m-r-6 fs-15 trans-04 zmdi zmdi-plus text-white"></i>
                <a class="text-white" asp-action="Create">Add Category</a>
            </div>
        }
        
    </div>
    <!-- Banner -->
    <div class="sec-banner bg0 p-t-80 p-b-50">
        <div class="container">
            <div class="row">

                @if (Model != null)
                {
                    foreach (var category in Model)
                    {
                        <div class="col-md-6 col-xl-4 p-b-30 m-lr-auto">

                            <div class="block1 wrap-pic-w position-relative">

                                @if (User.IsInRole("Admin"))
                                {
                                    <!-- ACTION BUTTONS -->
                                    <div class="category-side-actions">

                                        <a asp-action="Edit"
                                           asp-route-id="@category.Id"
                                           class="side-action-btn edit-btn">

                                            <i class="fa fa-edit"></i>

                                        </a>

                                        <button type="button"
                                                class="side-action-btn delete-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal-@category.Id">

                                            <i class="fa fa-trash"></i>

                                        </button>

                                    </div>

                                }
                                <!-- IMAGE -->
                                <img src="@Url.Content(category.ImageUrl)"
                                     alt="@category.Name" />

                                <!-- OVERLAY LINK -->
                                <a asp-controller="Product"
                                   asp-action="Index"
                                   asp-route-categoryId="@category.Id"
                                   class="block1-txt ab-t-l s-full flex-col-l-sb p-lr-38 p-tb-34 trans-03 respon3">

                                    <div class="block1-txt-child1 flex-col-l">

                                        <span class="block1-name ltext-102 trans-04 p-b-8">
                                            @category.Name
                                        </span>

                                        <span class="block1-info stext-102 trans-04">
                                            @category.Description
                                        </span>

                                    </div>

                                    <div class="block1-txt-child2 p-b-4 trans-05">
                                        <div class="block1-link stext-101 cl0 trans-09">
                                            Shop Now
                                        </div>
                                        
                                    </div>
                                    

                                </a>

                            </div>
                            <!-- Delete Confirmation Modal -->
                            <div class="modal fade mt-5"
                                 id="deleteModal-@category.Id"
                                 tabindex="-1">

                                <div class="modal-dialog modal-dialog-centered"
                                     style="margin-top:80px">

                                    <div class="modal-content">

                                        <!-- HEADER -->
                                        <div class="modal-header bg-danger text-white">

                                            <h5 class="modal-title">
                                                Delete Category
                                            </h5>

                                            <button type="button"
                                                    class="btn-close btn-close-white"
                                                    data-bs-dismiss="modal">
                                            </button>

                                        </div>

                                        <!-- BODY -->
                                        <div class="modal-body text-center">

                                            <p class="fw-semibold">
                                                Are you sure you want to delete this category
                                                from your system?
                                            </p>

                                            <h6 class="text-danger">
                                                @category.Name
                                            </h6>

                                        </div>

                                        <!-- FOOTER -->
                                        <div class="modal-footer">

                                            <!-- NO -->
                                            <button type="button"
                                                    class="btn btn-secondary"
                                                    data-bs-dismiss="modal">

                                                No

                                            </button>

                                            <!-- YES -->
                                            <form asp-action="Delete"
                                                  asp-route-id="@category.Id"
                                                  method="post">

                                                <button type="submit"
                                                        class="btn btn-danger">

                                                    Yes, Delete

                                                </button>

                                            </form>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        </div>
                    }
                }



            </div>
        </div>
    </div>
</div>
