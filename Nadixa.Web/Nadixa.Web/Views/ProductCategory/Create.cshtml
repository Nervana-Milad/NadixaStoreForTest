@model Nadixa.Web.Models.ViewModels.ProductCategoryViewModel

@{
    ViewData["Title"] = "Create Category";
}

<div class="container py-5" style="margin-top:100px">

    <div class="row justify-content-center">

        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">

                <h2 class="fw-bold mb-0">
                    Create Category
                </h2>

                <a asp-action="Index" asp-controller="ProductCategory"
                   class="btn  rounded-pill flex-c-m stext-106 cl6 size-105 bor4 pointer hov-btn3 trans-04 m-r-8 m-tb-4">
                    <i class="bi bi-arrow-left me-2"></i> Back
                </a>

            </div>

            <div class="card border-0 shadow rounded-4">

                <!-- HEADER -->
                @* <div class="card-header bg-dark text-white py-3 rounded-top-4">

                    <h3 class="mb-0 fw-bold">
                        Create Category
                    </h3>

                </div> *@

                <!-- BODY -->
                <div class="card-body p-5">

                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        <!-- NAME -->
                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- DESCRIPTION -->
                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                            </label>

                            <textarea asp-for="Description"
                                      rows="4"
                                      class="form-control rounded-3">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- IMAGE -->
                        <div class="mb-4">

                            <label asp-for="ImageFile"
                                   class="form-label fw-semibold">

                                Category Image

                            </label>

                            <input asp-for="ImageFile"
                                   type="file"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="ImageFile"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- BUTTONS -->
                        <div class="d-flex gap-3">

                            <button type="submit"
                                    class="btn btn-dark px-4 rounded-pill">

                                Create

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4 rounded-pill">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}