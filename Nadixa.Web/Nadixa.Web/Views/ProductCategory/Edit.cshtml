@model Nadixa.Web.Models.ViewModels.ProductCategoryViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container py-5" style="margin-top:100px">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Edit Category</h2>
            <p class="text-muted mb-0">
                Update category information
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-dark rounded-pill px-4">
            Back
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- Category Name -->
                <div class="mb-4">
                    <label asp-for="Name"
                           class="form-label fw-semibold">
                        Category Name
                    </label>

                    <input asp-for="Name"
                           class="form-control rounded-3 shadow-sm" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>
                </div>

                <!-- Description -->
                <div class="mb-4">
                    <label asp-for="Description"
                           class="form-label fw-semibold">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              rows="4"
                              class="form-control rounded-3 shadow-sm">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>
                </div>

                <!-- Current Image -->
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-4">
                        <label class="form-label fw-semibold d-block">
                            Current Image
                        </label>

                        <img src="@Model.ImageUrl"
                             alt="@Model.Name"
                             class="rounded-4 shadow-sm border"
                             width="180" />
                    </div>
                }

                <!-- Upload New Image -->
                <div class="mb-4">
                    <label asp-for="ImageFile"
                           class="form-label fw-semibold">
                        Upload New Image
                    </label>

                    <input asp-for="ImageFile"
                           type="file"
                           class="form-control rounded-3 shadow-sm" />

                    <span asp-validation-for="ImageFile"
                          class="text-danger">
                    </span>
                </div>

                <!-- Buttons -->
                <div class="d-flex gap-3 mt-4 align-items-center">                    
                        <div class="flex-c-m stext-106 cl6 size-105 bor4 pointer hov-btn3 trans-04 m-tb-4 px-3 mr-3" style="background-color:#6c7ae0; color:white">
                            <button type="submit" class="text-white">Save Changes</button>
                        </div>

                        <a asp-action="Index"
                           class="btn btn-outline-dark px-5 py-2 rounded-pill">
                            Cancel
                        </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}