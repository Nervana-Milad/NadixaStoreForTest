@using Nadixa.Core.Entities
@model Nadixa.Web.Models.ViewModels.PromotionFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "عرض جديد" : "تعديل العرض";
}

<div class="container order-section">

    <div class="order-card">

        <h2 class="order-title mb-4">@ViewData["Title"]</h2>

        <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">اسم العرض</label>
                    <input asp-for="Name" class="form-control" placeholder="مثال: خصم الجمعة البيضاء" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">وصف (اختياري)</label>
                    <input asp-for="Description" class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">نص البادچ</label>
                    <input asp-for="BadgeText" class="form-control" placeholder="خصم 20%" />
                </div>

                <div class="col-md-2 mb-3">
                    <label class="form-label">لون البادچ</label>
                    <input asp-for="BadgeColorHex" type="color" class="form-control form-control-color" />
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">نوع الخصم</label>
                    <select asp-for="Type" class="form-control" id="promoType">
                        <option value="@PromotionType.PercentageOff">خصم نسبة %</option>
                        <option value="@PromotionType.FixedAmountOff">خصم مبلغ ثابت</option>
                        <option value="@PromotionType.BuyXGetYFree">اشتري واحصل على مجاني</option>
                    </select>
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">النطاق</label>
                    <select asp-for="Scope" class="form-control" id="promoScope">
                        <option value="@PromotionScope.AllProducts">كل المنتجات</option>
                        <option value="@PromotionScope.Category">قسم معين</option>
                        <option value="@PromotionScope.SubCategory">قسم فرعي معين</option>
                        <option value="@PromotionScope.SpecificProduct">منتج محدد</option>
                    </select>
                </div>

            </div>

            <!-- حقول تظهر حسب نوع الخصم -->
            <div class="row" id="valueFields">
                <div class="col-md-3 mb-3">
                    <label class="form-label">القيمة (نسبة % أو مبلغ)</label>
                    <input asp-for="Value" type="number" step="0.01" class="form-control" />
                </div>
            </div>

            <div class="row" id="buyXGetYFields" style="display:none;">
                <div class="col-md-3 mb-3">
                    <label class="form-label">اشتري كمية</label>
                    <input asp-for="BuyQuantity" type="number" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">خد ببلاش</label>
                    <input asp-for="FreeQuantity" type="number" class="form-control" />
                </div>
            </div>

            <!-- حقول تظهر حسب النطاق -->
            <div class="row" id="categoryField" style="display:none;">
                <div class="col-md-6 mb-3">
                    <label class="form-label">القسم</label>
                    <select asp-for="ProductCategoryId" class="form-control">
                        <option value="">-- اختاري القسم --</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row" id="subCategoryField" style="display:none;">
                <div class="col-md-6 mb-3">
                    <label class="form-label">القسم الفرعي</label>
                    <select asp-for="ProductSubCategoryId" class="form-control">
                        <option value="">-- اختاري القسم الفرعي --</option>
                        @foreach (var sub in Model.SubCategories)
                        {
                            <option value="@sub.Id">@sub.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row" id="productField" style="display:none;">
                <div class="col-md-6 mb-3">
                    <label class="form-label">المنتج</label>
                    <select asp-for="ProductId" class="form-control">
                        <option value="">-- اختاري المنتج --</option>
                        @foreach (var p in Model.Products)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row">

                <div class="col-md-3 mb-3">
                    <label class="form-label">تاريخ البداية</label>
                    <input asp-for="StartDate" type="datetime-local" class="form-control" />
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">تاريخ النهاية</label>
                    <input asp-for="EndDate" type="datetime-local" class="form-control" />
                </div>

                <div class="col-md-2 mb-3">
                    <label class="form-label">الأولوية</label>
                    <input asp-for="Priority" type="number" class="form-control" />
                </div>

                <div class="col-md-2 mb-3 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label class="form-check-label">مفعّل</label>
                    </div>
                </div>

                <div class="col-md-2 mb-3 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsFirstPurchaseOnly" class="form-check-input" />
                        <label class="form-check-label">أول شراء فقط</label>
                    </div>
                </div>

            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-dark">حفظ</button>
                <a asp-action="Index" class="btn btn-outline-dark">إلغاء</a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <script>
        function toggleFields() {
            const type = document.getElementById('promoType').value;
            const scope = document.getElementById('promoScope').value;

            document.getElementById('valueFields').style.display =
                (type === 'BuyXGetYFree') ? 'none' : 'flex';
            document.getElementById('buyXGetYFields').style.display =
                (type === 'BuyXGetYFree') ? 'flex' : 'none';

            document.getElementById('categoryField').style.display = (scope === 'Category') ? 'flex' : 'none';
            document.getElementById('subCategoryField').style.display = (scope === 'SubCategory') ? 'flex' : 'none';
            document.getElementById('productField').style.display = (scope === 'SpecificProduct') ? 'flex' : 'none';
        }

        document.getElementById('promoType').addEventListener('change', toggleFields);
        document.getElementById('promoScope').addEventListener('change', toggleFields);
        document.addEventListener('DOMContentLoaded', toggleFields);
    </script>
}
