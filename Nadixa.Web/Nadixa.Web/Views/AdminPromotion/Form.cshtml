@using Nadixa.Core.Entities
@model Nadixa.Web.Models.ViewModels.PromotionFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "New Promotion" : "Edit Promotion";
}

<div class="container order-section">

    <div class="order-card">

        <h2 class="order-title mb-4">@ViewData["Title"]</h2>

        <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Promotion Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Black Friday Sale" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Description (optional)</label>
                    <input asp-for="Description" class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Badge Text</label>
                    <input asp-for="BadgeText" class="form-control" placeholder="20% OFF" />
                </div>

                <div class="col-md-2 mb-3">
                    <label class="form-label">Badge Color</label>
                    <input asp-for="BadgeColorHex" type="color" class="form-control form-control-color" />
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Discount Type</label>
                    <select asp-for="Type" class="form-control" id="promoType">
                        <option value="@PromotionType.PercentageOff">Percentage Off</option>
                        <option value="@PromotionType.FixedAmountOff">Fixed Amount Off</option>
                        <option value="@PromotionType.BuyXGetYFree">Buy X Get Y Free</option>
                    </select>
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Scope</label>
                    <select asp-for="Scope" class="form-control" id="promoScope">
                        <option value="@PromotionScope.AllProducts">All Products</option>
                        <option value="@PromotionScope.Category">Specific Category</option>
                        <option value="@PromotionScope.SubCategory">Specific Sub-Category</option>
                        <option value="@PromotionScope.SpecificProduct">Specific Product</option>
                    </select>
                </div>

            </div>

            <!-- Fields shown based on discount type -->
            <div class="row" id="valueFields">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Value (percentage or amount)</label>
                    <input asp-for="Value" type="number" step="0.01" class="form-control" />
                </div>
            </div>

            <div class="row" id="buyXGetYFields" style="display:none;">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Buy Quantity</label>
                    <input asp-for="BuyQuantity" type="number" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Free Quantity</label>
                    <input asp-for="FreeQuantity" type="number" class="form-control" />
                </div>
            </div>

            <!-- Fields shown based on scope -->
            <div class="row" id="categoryField" style="display:none;">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Category</label>
                    <select asp-for="ProductCategoryId" class="form-control">
                        <option value="">-- Select Category --</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row" id="subCategoryField" style="display:none;">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Sub-Category</label>
                    <select asp-for="ProductSubCategoryId" class="form-control">
                        <option value="">-- Select Sub-Category --</option>
                        @foreach (var sub in Model.SubCategories)
                        {
                            <option value="@sub.Id">@sub.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row" id="productField" style="display:none;">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Product</label>
                    <select asp-for="ProductId" class="form-control">
                        <option value="">-- Select Product --</option>
                        @foreach (var p in Model.Products)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row">

                <div class="col-md-3 mb-3">
                    <label class="form-label">Start Date</label>
                    <input asp-for="StartDate" type="datetime-local" class="form-control" />
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">End Date</label>
                    <input asp-for="EndDate" type="datetime-local" class="form-control" />
                </div>

                <div class="col-md-2 mb-3">
                    <label class="form-label">Priority</label>
                    <input asp-for="Priority" type="number" class="form-control" />
                </div>

                <div class="col-md-2 mb-3 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label class="form-check-label">Active</label>
                    </div>
                </div>

                <div class="col-md-2 mb-3 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsFirstPurchaseOnly" class="form-check-input" />
                        <label class="form-check-label">First Purchase Only</label>
                    </div>
                </div>

            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-dark">Save</button>
                <a asp-action="Index" class="btn btn-outline-dark">Cancel</a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <script>
        function toggleFields() {
            const type = document.getElementById('promoType').value;
            const scope = document.getElementById('promoScope').value;

            document.getElementById('valueFields').style.display =
                (type === 'BuyXGetYFree') ? 'none' : 'flex';
            document.getElementById('buyXGetYFields').style.display =
                (type === 'BuyXGetYFree') ? 'flex' : 'none';

            document.getElementById('categoryField').style.display = (scope === 'Category') ? 'flex' : 'none';
            document.getElementById('subCategoryField').style.display = (scope === 'SubCategory') ? 'flex' : 'none';
            document.getElementById('productField').style.display = (scope === 'SpecificProduct') ? 'flex' : 'none';
        }

        document.getElementById('promoType').addEventListener('change', toggleFields);
        document.getElementById('promoScope').addEventListener('change', toggleFields);
        document.addEventListener('DOMContentLoaded', toggleFields);
    </script>
}
