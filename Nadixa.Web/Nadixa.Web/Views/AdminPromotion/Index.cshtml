@using Nadixa.Core.Entities
@model List<Promotion>
@{
    ViewData["Title"] = "Manage Promotions";
}

<div class="container order-section">

    <div class="order-card">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="order-title">Promotions</h2>
            <a asp-action="Create" class="btn btn-dark">+ New Promotion</a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Scope</th>
                    <th>Value</th>
                    <th>From - To</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var promo in Model)
                {
                    <tr>
                        <td>
                            @promo.Name
                            @if (!string.IsNullOrEmpty(promo.BadgeText))
                            {
                                <span class="status-badge" style="background-color:@promo.BadgeColorHex; color:#fff;">
                                    @promo.BadgeText
                                </span>
                            }
                        </td>
                        <td>
                            @(promo.Type switch
                            {
                                PromotionType.PercentageOff => "Percentage Off",
                                PromotionType.FixedAmountOff => "Fixed Amount Off",
                                PromotionType.BuyXGetYFree => $"Buy {promo.BuyQuantity} Get {promo.FreeQuantity} Free",
                                _ => promo.Type.ToString()
                            })
                        </td>
                        <td>
                            @(promo.Scope switch
                            {
                                PromotionScope.AllProducts => "All Products",
                                PromotionScope.Category => promo.ProductCategory?.Name ?? "Category",
                                PromotionScope.SubCategory => promo.ProductSubCategory?.Name ?? "Sub-Category",
                                PromotionScope.SpecificProduct => promo.Product?.Name ?? "Specific Product",
                                _ => "-"
                            })
                        </td>
                        <td>
                            @(promo.Type == PromotionType.PercentageOff ? $"{promo.Value}%" :
                              promo.Type == PromotionType.FixedAmountOff ? $"L.E. {promo.Value}" : "-")
                        </td>
                        <td>
                            @promo.StartDate.ToString("dd MMM") - @promo.EndDate.ToString("dd MMM yyyy")
                        </td>
                        <td>
                            @if (promo.IsCurrentlyValid)
                            {
                                <span class="status-badge status-confirmed">Active</span>
                            }
                            else if (!promo.IsActive)
                            {
                                <span class="status-badge status-cancelled">Inactive</span>
                            }
                            else
                            {
                                <span class="status-badge status-pending">Out of Date Range</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@promo.Id" class="btn btn-sm btn-outline-dark">Edit</a>

                                <form asp-action="ToggleActive" asp-route-id="@promo.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        @(promo.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>

                                <form asp-action="Delete" asp-route-id="@promo.Id" method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>
