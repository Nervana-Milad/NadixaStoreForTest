@using Nadixa.Core.Entities
@model List<Promotion>
@{
    ViewData["Title"] = "إدارة العروض";
}

<div class="container order-section">

    <div class="order-card">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="order-title">العروض الترويجية</h2>
            <a asp-action="Create" class="btn btn-dark">+ عرض جديد</a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>الاسم</th>
                    <th>النوع</th>
                    <th>النطاق</th>
                    <th>القيمة</th>
                    <th>من - إلى</th>
                    <th>الحالة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var promo in Model)
                {
                    <tr>
                        <td>
                            @promo.Name
                            @if (!string.IsNullOrEmpty(promo.BadgeText))
                            {
                                <span class="status-badge" style="background-color:@promo.BadgeColorHex; color:#fff;">
                                    @promo.BadgeText
                                </span>
                            }
                        </td>
                        <td>
                            @(promo.Type switch
                            {
                                PromotionType.PercentageOff => "خصم نسبة",
                                PromotionType.FixedAmountOff => "خصم مبلغ ثابت",
                                PromotionType.BuyXGetYFree => $"اشتري {promo.BuyQuantity} خد {promo.FreeQuantity} ببلاش",
                                _ => promo.Type.ToString()
                            })
                        </td>
                        <td>
                            @(promo.Scope switch
                            {
                                PromotionScope.AllProducts => "كل المنتجات",
                                PromotionScope.Category => promo.ProductCategory?.Name ?? "قسم",
                                PromotionScope.SubCategory => promo.ProductSubCategory?.Name ?? "قسم فرعي",
                                PromotionScope.SpecificProduct => promo.Product?.Name ?? "منتج محدد",
                                _ => "-"
                            })
                        </td>
                        <td>
                            @(promo.Type == PromotionType.PercentageOff ? $"{promo.Value}%" :
                              promo.Type == PromotionType.FixedAmountOff ? $"L.E. {promo.Value}" : "-")
                        </td>
                        <td>
                            @promo.StartDate.ToString("dd MMM") - @promo.EndDate.ToString("dd MMM yyyy")
                        </td>
                        <td>
                            @if (promo.IsCurrentlyValid)
                            {
                                <span class="status-badge status-confirmed">شغال</span>
                            }
                            else if (!promo.IsActive)
                            {
                                <span class="status-badge status-cancelled">متوقف</span>
                            }
                            else
                            {
                                <span class="status-badge status-pending">خارج التاريخ</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@promo.Id" class="btn btn-sm btn-outline-dark">تعديل</a>

                                <form asp-action="ToggleActive" asp-route-id="@promo.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        @(promo.IsActive ? "إيقاف" : "تفعيل")
                                    </button>
                                </form>

                                <form asp-action="Delete" asp-route-id="@promo.Id" method="post"
                                      onsubmit="return confirm('متأكدة من الحذف؟');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>
