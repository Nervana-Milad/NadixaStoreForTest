@using Nadixa.Core.Entities
@model IEnumerable<Nadixa.Core.Entities.Product>

@{
    ViewData["Title"] = "Home Page";
}
<style>
	/* تصميم الشريط الترويجي الاحترافي (Banner) */
	.category-banner {
		/* تدريج لوني برتقالي مميز ليطابق الصورة */
		background: linear-gradient(135deg, #6C7AED 0%, #6C7AED 100%);
		border-radius: 6px;
		min-height: 52px;
	}

	.see-all-link {
		font-weight: 600;
		opacity: 0.95;
	}

		.see-all-link:hover {
			opacity: 1;
			color: #fff !important;
		}

		/* إضافة حركة تفاعلية مرنة للسهم عند تمرير الماوس */
		.see-all-link i {
			transition: transform 0.3s ease;
			display: inline-block;
		}

		.see-all-link:hover i {
			transform: translateX(-4px); /* تحريك السهم لليسار برفق عند التمرير */
		}

	/* كود الـ CSS لتنسيق وتصغير حجم الصور لتصبح متناسقة تماماً */
	.product-carousel-img {
		height: 200px !important;
		width: 100% !important;
		object-fit: contain !important;
		background-color: #f8f9fa;
		padding: 10px;
	}

	/* تنسيق أسهم الحركة لتظهر بشكل لائق وجميل فوق السلايدر */
	.custom-swiper-btn {
		color: #333 !important;
		background-color: rgba(255, 255, 255, 0.9);
		width: 40px !important;
		height: 40px !important;
		border-radius: 50%;
		box-shadow: 0 4px 10px rgba(0,0,0,0.15);
		transition: all 0.3s ease;
	}

		.custom-swiper-btn:hover {
			background-color: #6c7ae0;
			color: #fff !important;
		}

		.custom-swiper-btn::after {
			font-size: 16px !important;
			font-weight: bold;
		}
</style>


<!-- Slider -->
<section class="section-slide">
	<div class="wrap-slick1">
		<div class="slick1">
			<div class="item-slick1" style="background-image: url(images/slide-01.jpg);">
				<div class="container h-full">
					<div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
						<div class="layer-slick1 animated visible-false" data-appear="fadeInDown" data-delay="0">
							<span class="ltext-101 cl2 respon2">
								Women Collection 2018
							</span>
						</div>

						<div class="layer-slick1 animated visible-false" data-appear="fadeInUp" data-delay="800">
							<h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">
								NEW SEASON
							</h2>
						</div>

						<div class="layer-slick1 animated visible-false" data-appear="zoomIn" data-delay="1600">
							<a asp-controller="Product" asp-action="Index" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
								Shop Now
							</a>
						</div>
					</div>
				</div>
			</div>

			<div class="item-slick1" style="background-image: url(images/slide-02.jpg);">
				<div class="container h-full">
					<div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
						<div class="layer-slick1 animated visible-false" data-appear="rollIn" data-delay="0">
							<span class="ltext-101 cl2 respon2">
								Men New-Season
							</span>
						</div>

						<div class="layer-slick1 animated visible-false" data-appear="lightSpeedIn" data-delay="800">
							<h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">
								Jackets & Coats
							</h2>
						</div>

						<a asp-controller="Product" asp-action="Index"
   class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
    Shop Now
</a>
					</div>
				</div>
			</div>

			<div class="item-slick1" style="background-image: url(images/slide-03.jpg);">
				<div class="container h-full">
					<div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
						<div class="layer-slick1 animated visible-false" data-appear="rotateInDownLeft" data-delay="0">
							<span class="ltext-101 cl2 respon2">
								Men Collection 2018
							</span>
						</div>

						<div class="layer-slick1 animated visible-false" data-appear="rotateInUpRight" data-delay="800">
							<h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">
								New arrivals
							</h2>
						</div>

						<a asp-controller="Product" asp-action="Index"
   class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
    Shop Now
</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>


<!-- Banner -->
<div class="sec-banner bg0 p-t-80 p-b-50">
	<div class="container">
		<div class="row">
			@if (ViewBag.Categories != null)
			{
				@foreach (var category in ViewBag.Categories)
				{
					<div class="col-md-6 col-xl-4 p-b-30 m-lr-auto">
						<!-- Block1 -->
						<div class="block1 wrap-pic-w">
							<img src="@category.ImageUrl" alt="IMG-BANNER">

							<a asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id"
								class="block1-txt ab-t-l s-full flex-col-l-sb p-lr-38 p-tb-34 trans-03 respon3">
								
								<div class="block1-txt-child1 flex-col-l">
									<span class="block1-name ltext-102 trans-04 p-b-8">
										@category.Name
									</span>

									<span class="block1-info stext-102 trans-04">
										@category.Description
									</span>
								</div>
								
<a asp-controller="Product" asp-action="Index"
   class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
    Shop Now
</a>
							</a>
						</div>
					</div>
				}
			}

			
		</div>
	</div>
</div>


<!-- Product Section -->
<section class="bg0 p-t-23 p-b-140">
	<div class="container">
		<div class="p-b-10 m-b-40">
			<h3 class="ltext-103 cl5">
				Product Overview
			</h3>
		</div>

		@* 1. تجميع المنتجات برمجياً بناءً على اسم القسم *@
		@{
			var groupedProducts = Model.GroupBy(p => p.ProductCategory?.Name ?? "Other");
		}

		@* 2. عمل Loop على كل قسم لإنشاء السلايدر الخاص به *@
		@foreach (var categoryGroup in groupedProducts)
		{
			<div class="category-swiper-section m-b-60">

				<!-- شريط القسم الاحترافي (Banner) المتوافق مع الصورة -->
				<div class="category-banner d-flex justify-content-between align-items-center m-b-20 p-tb-12 p-lr-25 text-white shadow-sm" >
					<!-- اسم القسم والترويج يميناً -->
					<div class="d-flex align-items-center">
						<span class="mtext-101 font-weight-bold text-uppercase fs-16">
							@categoryGroup.Key
						</span>
						<span class="mx-3 d-none d-sm-inline opacity-5" style="border-left: 1px solid #fff; height: 18px;"></span>
						<span class="stext-109 opacity-8 d-none d-sm-inline fs-14">
							60% Discount For All Products
						</span>
					</div>

					<!-- رابط عرض الكل يساراً -->
					@{
						var firstProduct = categoryGroup.FirstOrDefault();
						var categoryId = firstProduct?.ProductCategoryId;
					}
					<a asp-controller="Product" asp-action="Index" asp-route-categoryId="@categoryId"
					   class="see-all-link stext-101 text-white d-flex align-items-center text-decoration-none trans-04 fs-14">
						<span>see All</span>
						<i class="bi bi-chevron-right m-l-5 align-self-center fs-12"></i>

					</a>
				</div>

				<!-- حاوية الـ Swiper الخاصة بهذا القسم -->
				<div class="swiper product-swiper position-relative p-lr-15">
					<div class="swiper-wrapper">
						@foreach (var product in categoryGroup)
						{
							<div class="swiper-slide pb-4 h-auto">
								<div class="block2 block2-shadow h-100 d-flex flex-column justify-content-between">
									<div>
										<div class="block2-pic hov-img0">
											<img src="@product.MainImageUrlPath" alt="@product.Name" class="img-fluid product-carousel-img">

											<a class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04 js-show-modal1 pointer"
											   data-id="@product.Id">
												Quick View
											</a>
										</div>

										<div class="block2-txt flex-w flex-t p-t-14">
											<div class="block2-txt-child1 flex-col-l px-3">
												<a asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id" class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6">
													@product.Name
												</a>

												<span class="stext-105 cl3">
													$@product.Price
												</span>
											</div>

											<div class="block2-txt-child2 flex-r p-3">
												<button class="js-addwish-detail fs-20 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2"
														data-product-id="@product.Id" data-product-name="@product.Name">
													<i class="zmdi zmdi-favorite-outline"></i>
												</button>
											</div>
										</div>

										<div class="px-3 pt-2">
											<p class="card-text" style="font-size: 13px; color: #666;">
												@(@product.Description != null && product.Description.Length > 50 ? product.Description.Substring(0, 50) + "..." : product.Description)
											</p>
										</div>
									</div>

									<div class="px-3 pt-2 d-flex justify-content-end">
										<span class="badge badge-secondary mb-4">@product.ProductCategory?.Name</span>
									</div>
								</div>
							</div>
						}
					</div>

					<!-- أسهم الحركة لكل سلايدر على حدة -->
					<div class="swiper-button-next custom-swiper-btn"></div>
					<div class="swiper-button-prev custom-swiper-btn"></div>
				</div>
			</div>
		}
	</div>
</section>

@section Scripts {
	<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			document.querySelectorAll('.product-swiper').forEach(function (el) {
				const nextButton = el.querySelector('.swiper-button-next');
				const prevButton = el.querySelector('.swiper-button-prev');

				new Swiper(el, {
					slidesPerView: 4,
					spaceBetween: 25,
					navigation: {
						nextEl: nextButton,
						prevEl: prevButton,
					},
					breakpoints: {
						320: {
							slidesPerView: 1,
							spaceBetween: 10
						},
						576: {
							slidesPerView: 2,
							spaceBetween: 15
						},
						768: {
							slidesPerView: 3,
							spaceBetween: 20
						},
						1024: {
							slidesPerView: 4,
							spaceBetween: 25
						}
					}
				});
			});
		});
	</script>
}