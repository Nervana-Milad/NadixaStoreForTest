@{
    ViewData["Title"] = "About";
}


<!-- Title page -->
<section class="bg-img1 txt-center p-lr-15 p-tb-92" style="background-image: url('@Url.Content("~/images/bg-01.jpg")');margin-top:80px">
	<h2 class="ltext-105 cl0 txt-center">
		About
	</h2>
</section>


<!-- Content page -->
<section class="bg0 p-t-75 p-b-120">
	<div class="container">
		<div class="row p-b-148">
			<div class="col-md-7 col-lg-8">
				<div class="p-t-7 p-r-85 p-r-15-lg p-r-0-md">
					<h3 class="mtext-111 cl2 p-b-16">
						Our Story
					</h3>

					<p class="stext-113 cl6 p-b-26">
						Welcome to Nadixa Shop! We started this project to make online shopping easier, faster, and more enjoyable for everyone. Our platform offers a curated selection of products with detailed descriptions, real-time availability, and secure checkout. Every feature, from product galleries to quick edits, is designed with both the customer and admin in mind.
					</p>

					<p class="stext-113 cl6 p-b-26">
						Our team is passionate about quality and usability. We continuously improve the site by adding new features like multi-image product previews, drag & drop galleries, and intuitive admin controls. Our goal is to provide a seamless shopping experience while keeping the management tools simple and powerful for store owners.
					</p>

					<p class="stext-113 cl6 p-b-26">
						Have questions or feedback? Reach out to us anytime at support@nadixa.com or call us at (+20) 100 123 4567. We’re here to help and ensure your experience on our platform is smooth and enjoyable.
					</p>
				</div>
			</div>

			<div class="col-11 col-md-5 col-lg-4 m-lr-auto">
				<div class="how-bor1 ">
					<div class="hov-img0">
						<img src="~/images/about-01.jpg" alt="IMG">
					</div>
				</div>
			</div>
		</div>

		<div class="row">
			<div class="order-md-2 col-md-7 col-lg-8 p-b-30">
				<div class="p-t-7 p-l-85 p-l-15-lg p-l-0-md">
					<h3 class="mtext-111 cl2 p-b-16">
						Our Mission
					</h3>

					<p class="stext-113 cl6 p-b-26">
						At Nadixa Shop, we believe that great online shopping should be simple, enjoyable, and reliable. Every feature of our platform has been thoughtfully designed—from detailed product pages with multiple image previews to a powerful admin panel for managing inventory efficiently. We aim to provide a seamless experience for both shoppers and store owners, combining functionality with a clean, modern design.
					</p>

					<div class="bor16 p-l-29 p-b-9 m-t-22">
						<p class="stext-114 cl6 p-r-40 p-b-11">
							"Innovation isn’t just about new features; it’s about making things easier, faster, and more delightful for people who use your platform every day."
						</p>

						<span class="stext-111 cl8">
							- Nadixa Team
						</span>
					</div>
				</div>
			</div>

			<div class="order-md-1 col-11 col-md-5 col-lg-4 m-lr-auto p-b-30">
				<div class="how-bor2">
					<div class="hov-img0">
						<img src="~/images/about-02.jpg" alt="IMG">
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
