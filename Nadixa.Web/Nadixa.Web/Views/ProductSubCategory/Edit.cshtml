@model Nadixa.Web.Models.ViewModels.ProductSubCategoryViewModel

@{
    ViewData["Title"] = "Edit SubCategory";
}

<div class="container py-5" style="margin-top:100px">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow rounded-4">

                <!-- HEADER -->
                <div class="card-header bg-dark text-white py-3 rounded-top-4">

                    <h3 class="mb-0 fw-bold">
                        Edit SubCategory
                    </h3>

                </div>

                <!-- BODY -->
                <div class="card-body p-5">

                    <form asp-action="Edit"
                          method="post"
                          enctype="multipart/form-data">

                        <!-- NAME -->
                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- DESCRIPTION -->
                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                            </label>

                            <textarea asp-for="Description"
                                      rows="4"
                                      class="form-control rounded-3">
                            </textarea>

                        </div>

                        <!-- CATEGORY -->
                        <div class="mb-4">

                            <label asp-for="ProductCategoryId"
                                   class="form-label fw-semibold">

                                Parent Category

                            </label>

                            <select asp-for="ProductCategoryId"
                                    class="form-select rounded-3">

                                <option value="">
                                    Select Category
                                </option>

                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">
                                        @category.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="ProductCategoryId"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- IMAGE -->
                        <div class="mb-4">

                            <label asp-for="ImageFile"
                                   class="form-label fw-semibold">

                                SubCategory Image

                            </label>
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mb-3">

                                    <img src="@Url.Content(Model.ImageUrl)"
                                         width="150"
                                         class="rounded shadow-sm" />

                                </div>
                            }
                            <input asp-for="ImageFile"
                                   type="file"
                                   class="form-control rounded-3" />

                        </div>

                        <!-- BUTTONS -->
        
                        <div class="d-flex gap-3 mt-4 align-items-center">
                            <div class="flex-c-m stext-106 cl6 size-105 bor4 pointer hov-btn3 trans-04 m-tb-4 px-3 mr-3" style="background-color:#6c7ae0; color:white">
                                <button type="submit" class="text-white">Save Changes</button>
                            </div>

                            <a asp-action="Index"
                               class="btn btn-outline-dark px-5 py-2 rounded-pill">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}