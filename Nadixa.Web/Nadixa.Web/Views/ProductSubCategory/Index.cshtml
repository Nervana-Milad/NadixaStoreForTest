@model List<Nadixa.Application.DTOS.ProductSubCategory.SubCategoryDto>

@{
    ViewData["Title"] = "SubCategories";
}

<div class="container py-5 categories-page">

    <!-- HEADER -->
    <div class="page-header d-flex justify-content-between align-items-center mb-5">
        <div>
            <span class="page-eyebrow">
                STORE MANAGEMENT
            </span>

            <h2 class="page-title mb-2">
                Product SubCategories
            </h2>

            <p class="page-subtitle mb-0">
                Organize your products into clear and attractive categories.
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create"
               class="add-category-btn">
                <i class="bi bi-plus-lg"></i>
                <span>Add SubCategory</span>
            </a>
        }
    </div>


    <!-- EMPTY STATE -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="bi bi-grid"></i>
            </div>

            <h4>No Categories Yet</h4>

            <p>
                Start organizing your store by creating your first product category.
            </p>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create"
                   class="add-category-btn mt-3">
                    <i class="bi bi-plus-lg"></i>
                    Add SubCategory
                </a>
            }
        </div>
    }
    else
    {
        <!-- CATEGORIES GRID -->
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="category-card">

                        <!-- IMAGE -->
                        <div class="category-image-wrapper">
                            <img src="@Url.Content(item.ImageUrl)"
                                 alt="@item.Name"
                                 class="category-image" />

                            <div class="category-image-overlay"></div>

                            @if (User.IsInRole("Admin"))
                            {
                                <!-- ADMIN ACTIONS -->
                                <div class="category-actions">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="category-action edit-action"
                                       title="Edit SubCategory">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <button type="button"
                                            class="category-action delete-action delete-subcategory-btn"
                                            data-subcategory-id="@item.Id"
                                            data-subcategory-name="@item.Name"
                                            title="Delete SubCategory">
                                        <i class="bi bi-trash3"></i>
                                    </button>

                                </div>
                            }

                            <!-- SubCATEGORY LINK -->
                            <a asp-controller="Product"
                               asp-action="Index"
                               asp-route-subcategoryId="@item.Id"
                               class="category-shop-link">

                                <span>View Products</span>

                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>


                        <!-- CONTENT -->
                        <div class="category-content">

                            <h4 class="category-name">
                                @item.Name
                            </h4>

                            <p class="category-description">
                                @(string.IsNullOrWhiteSpace(item.Description)
                                                        ? "Explore products in this category."
                                                        : item.Description)
                            </p>
                        </div>
                    </div>
                </div>
                }
        </div>

        <!-- DELETE FORM -->
        <form id="deleteSubCategoryForm" method="post">
            @Html.AntiForgeryToken()
        </form>
    }

</div>