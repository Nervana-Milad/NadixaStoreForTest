@model List<Nadixa.Core.Entities.ProductSubCategory>

@{
    ViewData["Title"] = "SubCategories";
}

    <div class="container py-5" style="margin-top:100px">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h2 class="fw-bold mb-1">
                    Product SubCategories
                </h2>

                <p class="text-muted mb-0">
                    Manage your store subcategories
                </p>
            </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create"
               class="btn btn-dark rounded-pill px-4 shadow-sm">
                <i class="fa fa-plus me-2"></i>
                Add SubCategory
            </a>
        }
        </div>

        <!-- EMPTY -->
        @if (Model == null || Model.Count == 0)
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
                <h4 class="fw-bold mb-3">
                    No SubCategories Yet
                </h4>
                <p class="text-muted">
                    Start by creating your first subcategory
                </p>
            </div>
        }
        else
        {
            <!-- GRID -->
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                            <!-- IMAGE -->
                            <div style="height:250px; overflow:hidden;">

                                <img src="@Url.Content(item.ImageUrl)"
                                     class="w-100 h-100"
                                     style="object-fit:cover;"
                                     alt="@item.Name" />
                            </div>
                            <!-- BODY -->
                            <div class="card-body p-4">
                                <!-- NAME -->
                                <h4 class="fw-bold mb-2">
                                    @item.Name
                                </h4>

                                <!-- CATEGORY -->
                                <div class="mb-3">
                                    <span class="badge bg-dark rounded-pill px-3 py-2">
                                        @item.ProductCategory.Name
                                    </span>
                                </div>

                                <!-- DESCRIPTION -->
                                <p class="text-muted small mb-4">
                                    @(string.IsNullOrEmpty(item.Description)
                                                                ? "No description available"
                                                                : item.Description)
                        </p>

                                <!-- ACTIONS -->
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-dark rounded-pill w-100">
                                        Edit
                                    </a>
                                    <button type="button"
                                            class="btn btn-danger rounded-pill w-100"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal-@item.Id">
                                        Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- DELETE MODAL -->
                    <div class="modal fade"
                         id="deleteModal-@item.Id"
                         tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered"
                             style="margin-top:80px">
                            <div class="modal-content">
                                <div class="modal-header bg-danger text-white">
                                    <h5 class="modal-title">
                                        Delete SubCategory
                                    </h5>
                                    <button type="button"
                                            class="btn-close btn-close-white"
                                            data-bs-dismiss="modal">
                                    </button>
                                </div>

                                <div class="modal-body text-center">
                                    <p class="fw-semibold">
                                        Are you sure you want to delete this subcategory
                                        from your system?
                                    </p>
                                    <h6 class="text-danger">
                                        @item.Name
                                    </h6>
                                </div>

                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post">

                                        <button type="submit" class="btn btn-danger">Yes, Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                        }
            </div>
        }
    </div>
