@model Nadixa.Web.Models.ViewModels.ProductSubCategoryViewModel

@{
    ViewData["Title"] = "Create SubCategory";
}

<div class="container py-5" style="margin-top:100px">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h2 class="fw-bold mb-0">
                    Create SubCategory
                </h2>

                <a href="javascript:history.back()"
                   class="btn rounded-pill flex-c-m stext-106 cl6 size-105 bor4 pointer hov-btn3 trans-04 m-r-8 m-tb-4">
                    <i class="bi bi-arrow-left me-2"></i> Back
                </a>

            </div>


                <!-- BODY -->
                <div class="card-body p-5">

                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        <!-- NAME -->
                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- DESCRIPTION -->
                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                            </label>

                            <textarea asp-for="Description"
                                      rows="4"
                                      class="form-control rounded-3">
                            </textarea>

                        </div>

                        <!-- CATEGORY -->
                        <div class="mb-4">

                            <label asp-for="ProductCategoryId"
                                   class="form-label fw-semibold">

                                Parent Category

                            </label>

                            <select asp-for="ProductCategoryId"
                                    class="form-select rounded-3">

                                <option value="">
                                    Select Category
                                </option>

                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">
                                        @category.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="ProductCategoryId"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- IMAGE -->
                        <div class="mb-4">

                            <label asp-for="ImageFile"
                                   class="form-label fw-semibold">

                                SubCategory Image

                            </label>

                            <input asp-for="ImageFile"
                                   type="file"
                                   class="form-control rounded-3" />

                        </div>

                        <!-- BUTTONS -->
                        <div class="d-flex gap-3">

                            <button type="submit"
                                class="btn btn-dark hov-btn3 mr-3 px-4 rounded-pill">
                                Create
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary hov-btn3 px-4 rounded-pill">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}