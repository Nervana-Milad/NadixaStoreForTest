@model Nadixa.Web.Models.ViewModels.PaginationViewModel

@if (Model.TotalPages > 1)
{
    <div class="flex-c-m flex-w w-full p-t-45">
        <div class="flex-c-m flex-w w-full">

            @if (Model.CurrentPage > 1)
            {
                <a asp-controller="@Model.Controller"
                   asp-action="@Model.Action"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   class="flex-c-m how-pagination1 trans-04 m-all-7">
                    <i class="zmdi zmdi-chevron-left"></i>
                </a>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                if (i == Model.CurrentPage)
                {
                    <span class="flex-c-m how-pagination1 trans-04 m-all-7 active-pagination1">@i</span>
                }
                else
                {
                    <a asp-controller="@Model.Controller"
                       asp-action="@Model.Action"
                       asp-route-page="@i"
                       class="flex-c-m how-pagination1 trans-04 m-all-7">
                        @i
                    </a>
                }
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-controller="@Model.Controller"
                   asp-action="@Model.Action"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   class="flex-c-m how-pagination1 trans-04 m-all-7">
                    <i class="zmdi zmdi-chevron-right"></i>
                </a>
            }
        </div>
    </div>
}