			<div class="workday-style-footer" style="background-color: #f3f5f7; padding: 40px 0; text-align: center; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <div class="container" style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 15px;">
        
        <!-- نص Follow Us -->
        <span style="color: #626a73; font-size: 15px; font-weight: 500;">Follow Us</span>

        <!-- أزرار وسائل التواصل الدائرية -->
        <div style="display: flex; gap: 12px; justify-content: center; align-items: center;">
            <a href="#" style="width: 36px; height: 36px; background-color: #707c8a; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #ffffff; text-decoration: none; font-size: 16px; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#5a6572'" onmouseout="this.style.backgroundColor='#707c8a'">
                <i class="bi bi-facebook"></i>
            </a>
            <a href="#" style="width: 36px; height: 36px; background-color: #707c8a; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #ffffff; text-decoration: none; font-size: 16px; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#5a6572'" onmouseout="this.style.backgroundColor='#707c8a'">
                <i class="bi bi-youtube"></i>
            </a>
            <a href="#" style="width: 36px; height: 36px; background-color: #707c8a; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #ffffff; text-decoration: none; font-size: 15px; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#5a6572'" onmouseout="this.style.backgroundColor='#707c8a'">
                <i class="bi bi-twitter-x"></i>
            </a>
            <a href="#" style="width: 36px; height: 36px; background-color: #707c8a; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #ffffff; text-decoration: none; font-size: 16px; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#5a6572'" onmouseout="this.style.backgroundColor='#707c8a'">
                <i class="bi bi-linkedin"></i>
            </a>
        </div>

        <!-- رابط سياسة الخصوصية -->
        <a href="#" style="color: #0056b3; font-size: 14px; text-decoration: none; font-weight: 500; margin-top: 5px;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">Privacy policy</a>

        <!-- الخط الرمادي الرفيع بالمنتصف -->
        <div style="width: 140px; height: 1px; background-color: #d1d5db; margin: 10px 0;"></div>

        <!-- اسم وشعار البراند NADIXA -->
        <div style="font-size: 15px; font-weight: bold; color: #707c8a; letter-spacing: 2px; text-transform: uppercase;">
            NADIXA
        </div>

        <!-- حقوق الملكية -->
        <span style="color: #626a73; font-size: 12px;">&copy; @DateTime.Now.Year NADIXA, Inc. All rights reserved.</span>
    </div>
</div>