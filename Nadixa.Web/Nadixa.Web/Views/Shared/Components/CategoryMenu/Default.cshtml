@model IEnumerable<Nadixa.Core.Entities.ProductCategory>

<li class="dropdown">
    <a href="#">Categories</a>

    <ul class="sub-menu">
        @foreach (var category in Model)
        {
            <li>
                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-categoryId="@category.Id">
                    @category.Name
                </a>
            </li>
            
        }
        
    </ul>
</li>