@using Nadixa.Web.Helpers
@inject Nadixa.Application.Interfaces.IPermissionService PermissionService

@{
	bool isAdmin = User.IsInRole("Admin");
	bool isSubAdmin = User.IsInRole("SubAdmin");

	bool canEditProducts = isAdmin || await PermissionService.UserHasPermissionAsync(User, "EditProductQuantity");
	bool canEditOrders = isAdmin || await PermissionService.UserHasPermissionAsync(User, "EditOrderStatus");

	// القائمة تظهر لو Admin، أو SubAdmin عنده صلاحية واحدة على الأقل من دول
	bool showAdminMenu = isAdmin || (isSubAdmin && (canEditProducts || canEditOrders));
}



<header>

	<!-- Header desktop -->
	<div class="container-menu-desktop">
		<!-- Topbar -->
		<div class="top-bar">
			<div class="content-topbar flex-sb-m h-full container">
				<div class="left-top-bar">
					Free shipping for standard order over $100
				</div>

				<div class="right-top-bar flex-w h-full">
					<a asp-controller="Help" asp-action="Index" class="flex-c-m trans-04 p-lr-25">
						Help & FAQs
					</a>

					

					@if (User.Identity.IsAuthenticated)
					{
						<a asp-controller="Profile" asp-action="Index" class="flex-c-m trans-04 p-lr-25">
							My Account
						</a>
					}
					else
					{
						<a href="#" id="myAccountBtn" class="flex-c-m trans-04 p-lr-25">
							My Account
						</a>
					}


					<a href="#" class="flex-c-m trans-04 p-lr-25">
						EN
					</a>

					<a href="#" class="flex-c-m trans-04 p-lr-25">
						USD
					</a>

				</div>
			</div>

			<div class="wrap-menu-desktop">
				<nav class="limiter-menu-desktop container">

					<!-- Logo desktop -->
					<a href="#" class="logo">
						<img src="~/images/icons/logo-01.png" alt="IMG-LOGO">
					</a>

					<!-- Menu desktop -->
					<div class="menu-desktop">
						<ul class="main-menu">
						
							<li class="@Html.IsActive("Home", "Index")">
								<a asp-action="Index" asp-controller="Home">Home</a>
							</li>

							<li class="@Html.IsActive("Product", "Index")">
								<a asp-action="Index" asp-controller="Product">Shop</a>
							</li>


							@await Component.InvokeAsync("CategoryMenu")

								@if (showAdminMenu)
								{
									<li>
										<a href="#">Admin</a>

										<ul class="sub-menu">
										@if (isAdmin)
										{
											{
												<li>
													<a asp-controller="ProductCategory" asp-action="Index">Categories</a>
												</li>
												<li>
													<a asp-controller="ProductSubCategory" asp-action="Index">Sub Categories</a>
												</li>
											}
										}
										@if (canEditProducts)
										{
											<li>
												<a asp-controller="Product" asp-action="Index">Products</a>
											</li>
										}
										@if (canEditOrders)
										{
											<li>
												<a asp-controller="AdminOrder" asp-action="Index">Orders</a>
											</li>
										}
										@if (isAdmin)
										{
											<li>
												<a asp-controller="AdminPromotion" asp-action="Index">Promotions</a>
											</li>
											<li>
												<a asp-controller="AdminCoupon" asp-action="Index">Coupons</a>
											</li>
											<li>
												<a asp-controller="AdminUser" asp-action="Index">Manage Users</a>
											</li>
											<li>
												<a asp-controller="AdminPermission" asp-action="Index">Manage Permissions</a>
											</li>
										}
										
										</ul>
									</li>
								}

							<li class="@Html.IsActive("Blog", "Index")">
								<a asp-action="Index" asp-controller="Blog">Blog</a>
							</li>

						
							<li class="@Html.IsActive("Home", "About")">
								<a asp-action="About" asp-controller="Home">About</a>
							</li>

							<li class="@Html.IsActive("Contact", "Index")">
								<a asp-controller="Contact" asp-action="Index">Contact</a>
							</li>
						</ul>
					</div>

					<!-- Icon header -->
					<div class="wrap-icon-header flex-w flex-r-m">
						@if (User.Identity.IsAuthenticated)
						{
							<div class="icon-header-item cl2 hov-cl1 trans-04 p-l-22 p-r-11 js-show-modal-search">
								<i class="zmdi zmdi-search"></i>
							</div>
						
							<div id="mini-cart-container">
								@await Component.InvokeAsync("Cart")
							</div>

							<div id="mini-wishlist-container">
								@await Component.InvokeAsync("Wishlist")
							</div>

							@if (User.IsInRole("Admin"))
							{
								<a asp-controller="AdminDashboard" asp-action="Index"
								   class="icon-header-item cl2 hov-cl1 trans-04 p-l-22 p-r-11" title="Admin Dashboard">
									<i class="zmdi zmdi-view-dashboard fs-22"></i>
								</a>
							}

							<a asp-controller="Auth" asp-action="Logout" class="icon-header-item cl2 hov-cl1 trans-04 p-l-22 p-r-11">
								<i class="bi bi-box-arrow-right fs-30"></i>
							</a>
						}
						else
						{
							<div class="d-flex ms-auto gap-2 me-5">
								<ul class="main-menu">
									<li class="@Html.IsActive("Auth", "Login")">
										<a asp-action="Login" asp-controller="Auth">Login</a>
									</li>
									<li class="@Html.IsActive("Auth", "Register")">
										<a asp-action="Register" asp-controller="Auth">Register</a>
									</li>
								
								</ul>
							</div>
						}
					</div>
				</nav>
			</div>
		</div>
	</div>
	
<!-- Header Mobile -->
	<div class="wrap-header-mobile">
		<!-- Logo moblie -->
		<div class="logo-mobile">
			<a href="index.html"><img src="~/images/icons/logo-01.png" alt="IMG-LOGO"></a>
		</div>

		<!-- Icon header -->
		<div class="wrap-icon-header flex-w flex-r-m m-r-15">
			<div class="icon-header-item cl2 hov-cl1 trans-04 p-r-11 js-show-modal-search">
				<i class="zmdi zmdi-search"></i>
			</div>

			<div id="mini-cart-container">
				@await Component.InvokeAsync("Cart")
			</div>

			<a asp-action="Index" asp-controller="Wishlist" class="dis-block icon-header-item cl2 hov-cl1 trans-04 p-r-11 p-l-10 icon-header-noti" data-notify="0">
				<i class="zmdi zmdi-favorite-outline"></i>
			</a>
		</div>

		<!-- Button show menu -->
		<div class="btn-show-menu-mobile hamburger hamburger--squeeze">
			<span class="hamburger-box">
				<span class="hamburger-inner"></span>
			</span>
		</div>
	</div>

	<!-- Menu Mobile -->
	<div class="menu-mobile">
		<ul class="topbar-mobile">
			<li>
				<div class="left-top-bar">
					Free shipping for standard order over $100
				</div>
			</li>

			<li>
				<div class="right-top-bar flex-w h-full">
					<a asp-controller="Help" asp-action="Index" class="flex-c-m p-lr-10 trans-04">
						Help & FAQs
					</a>

					
					@if (User.Identity.IsAuthenticated)
					{
						<a asp-controller="Profile" asp-action="Index" class="flex-c-m p-lr-10 trans-04">
							My Account
						</a>
					}
					else
					{
						<a href="#" id="myAccountBtn" class="flex-c-m p-lr-10 trans-04">
							My Account
						</a>
					}

					<a href="#" class="flex-c-m p-lr-10 trans-04">
						EN
					</a>

					<a href="#" class="flex-c-m p-lr-10 trans-04">
						USD
					</a>
				</div>
			</li>
		</ul>

		<ul class="main-menu-m">
			<li>
				<a asp-action="Index" asp-controller="Home">Home</a>
				<ul class="sub-menu-m">
					<li class="@Html.IsActive("Home", "Index")"><a>Home</a></li>

				</ul>
				<span class="arrow-main-menu-m">
					<i class="fa fa-angle-right" aria-hidden="true"></i>
				</span>
			</li>

			<li class="@Html.IsActive("Product", "Index")">
				<a asp-action="Index" asp-controller="Product">Shop</a>
			</li>

			

			@await Component.InvokeAsync("CategoryMenu")

			@if (showAdminMenu)
			{
				<li>
					<a href="#">Admin</a>

					<ul class="sub-menu-m">
						@if (isAdmin)
						{
							<li>
								<a asp-controller="ProductCategory" asp-action="Index">Categories</a>
							</li>
							<li>
								<a asp-controller="ProductSubCategory" asp-action="Index">Sub Categories</a>
							</li>
						}

						@if (canEditProducts)
						{
							<li>
								<a asp-controller="Product" asp-action="Index">Products</a>
							</li>
						}

						@if (canEditOrders)
						{
							<li>
								<a asp-controller="AdminOrder" asp-action="Index">Orders</a>
							</li>
						}

						@if (isAdmin)
						{
							<li>
								<a asp-controller="AdminPromotion" asp-action="Index">Promotions</a>
							</li>
							<li>
								<a asp-controller="AdminCoupon" asp-action="Index">Coupons</a>
							</li>
							<li>
								<a asp-controller="AdminUser" asp-action="Index">Manage Users</a>
							</li>
							<li>
								<a asp-controller="AdminPermission" asp-action="Index">Manage Permissions</a>
							</li>
						}
					</ul>
					<span class="arrow-main-menu-m">
						<i class="fa fa-angle-right" aria-hidden="true"></i>
					</span>
				</li>
			}
			<li class="@Html.IsActive("Blog", "Index")">
				<a asp-action="Index" asp-controller="Blog">Blog</a>
			</li>
			
			<li class="@Html.IsActive("Home", "About")">
				<a asp-action="About" asp-controller="Home">About</a>
			</li>
			

			<li class="@Html.IsActive("Contact", "Index")">
				<a asp-action="Index" asp-controller="Contact">Contact</a>
			</li>
			@if (User.Identity.IsAuthenticated)
			{
				<li class="@Html.IsActive("Auth", "Logout")">
					<a asp-controller="Auth" asp-action="Logout" class="icon-header-item cl2 hov-cl1 trans-04 p-l-22 p-r-11">
						Logout
					</a>
				</li>
			}
			else
			{
			<li class="@Html.IsActive("Auth", "Login")">
				<a asp-action="Login" asp-controller="Auth">Login</a>
			</li>
			<li class="@Html.IsActive("Auth", "Register")">
				<a asp-action="Register" asp-controller="Auth">Register</a>
			</li>
			}
			
			
		</ul>
	</div>

	<!-- Modal Search -->
	<div class="modal-search-header flex-c-m trans-04 js-hide-modal-search">
		<div class="container-search-header">
			<button class="flex-c-m btn-hide-modal-search trans-04 js-hide-modal-search">
				<img src="~/images/icons/icon-close2.png" alt="CLOSE">
			</button>

			<div class="wrap-search-header flex-w p-l-15 position-relative">
				<button class="flex-c-m trans-04">
					<i class="zmdi zmdi-search"></i>
				</button>
				<input id="globalSearchInput" type="text" placeholder="Search products, categories, blogs...">

				<!-- Dropdown Results -->
				<div id="globalSearchResults"
					 style="display:none; position:absolute; top:100%; left:0; width:100%; background:#fff; border-radius:8px; box-shadow:0 8px 24px rgba(0,0,0,0.12); z-index:9999; max-height:400px; overflow-y:auto;">
				</div>
			</div>
		</div>
	</div>


</header>
