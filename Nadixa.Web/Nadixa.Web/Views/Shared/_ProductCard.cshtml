@model Nadixa.Web.Models.ViewModels.ProductCardViewModel
@{
    var product = Model.Product;
    var qty = Model.CartQuantity;
}

<div class="block2 block2-shadow h-100 d-flex flex-column justify-content-between" style="position:relative;">

    @if (!string.IsNullOrEmpty(product.BadgeText))
    {
        <span style="position:absolute; top:10px; left:10px; z-index:5; background-color:@(product.BadgeColorHex ?? "#FF3B30"); color:#fff; font-size:11px; font-weight:700; padding:4px 10px; border-radius:20px;">
            @product.BadgeText
        </span>
    }

    <div class="block2-pic hov-img0">
        <img src="@product.PictureUrl" alt="@product.Name" class="img-fluid"
             style="height:270px; object-fit:cover;">

        <a class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04 js-show-modal1 pointer"
           data-id="@product.Id">
            Quick View
        </a>
    </div>

    <div class="block2-txt flex-w flex-t p-t-14">
        <div class="block2-txt-child1 flex-col-l px-3">
            <a asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id" class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6">
                @product.Name
            </a>

            @* السعر: أولوية لعرض الـ Promotion لو موجود، وإلا السعر القديم العادي *@
            <div class="d-flex align-items-center flex-wrap">
                @if (product.DiscountedPrice != null && product.DiscountedPrice < product.Price)
                {
                    <span class="stext-105" style="color:#e74c3c; font-weight:700;">$@product.DiscountedPrice.Value.ToString("N2")</span>
                    <span class="stext-105 ml-2" style="text-decoration: line-through; color:#999; font-size: 0.85em;">
                        $@product.Price
                    </span>
                }
                else if (product.OldPrice > 0 && product.OldPrice > product.Price)
                {
                    <span class="stext-105 cl3 mr-2">$@product.Price</span>
                    <span class="stext-105" style="text-decoration: line-through; color:#999; font-size: 0.85em;">
                        $@product.OldPrice
                    </span>
                }
                else
                {
                    <span class="stext-105 cl3">$@product.Price</span>
                }
            </div>
        </div>

        <div class="block2-txt-child2 flex-r p-3">
            <button class="js-addwish-detail fs-20 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 wishlist-btn"
                    data-product-id="@product.Id" data-product-name="@product.Name">
                <i class="zmdi zmdi-favorite-outline"></i>
            </button>
        </div>
    </div>

    <div class="px-3 pt-2">
        <p class="card-text" style="font-size: 13px; color: #666;">
            @(product.Description != null && product.Description.Length > 50
                        ? product.Description.Substring(0, 50) + "..."
                        : product.Description)
        </p>
    </div>

    <div class="px-3 pt-2 d-flex justify-content-between">
        <div class="mt-1">
            @if (product.StockQuantity > 0)
            {
                <span class="badge badge-light text-success" style="font-size: 0.75em;">
                    @product.StockQuantity in stock
                </span>
            }
            else
            {
                <span class="badge badge-light text-danger" style="font-size: 0.75em;">
                    Out of stock
                </span>
            }
        </div>
        <span class="badge badge-secondary mb-4">@product.Category</span>
    </div>

    <div class="px-3 pb-3 mt-auto">
        <div class="cart-controls" data-product-id="@product.Id">
            @if (qty > 0)
            {
                <div class="cart-counter">
                    <button class="cart-minus" data-product-id="@product.Id">
                        @(qty == 1 ? "🗑" : "-")
                    </button>
                    <span class="cart-qty">@qty in cart</span>
                    <button class="cart-plus"
                            data-product-id="@product.Id"
                            @(qty >= product.StockQuantity ? "disabled" : "")>
                        +
                    </button>
                </div>
            }
            else if (product.StockQuantity > 0)
            {
                <button class="btn-addcart-card js-addcart-detail hov-btn3"
                        data-product-id="@product.Id">
                    Add to Cart
                </button>
            }
            else if (Model.NotifyRequested)
            {
                <button class="btn-notify-me hov-btn3 w-100" disabled
                        style="background-color:#333; color:#fff; opacity:0.6; cursor:not-allowed;">
                    <i class="zmdi zmdi-check"></i> We'll notify you!
                </button>
            }
            else
            {
                <button class="btn-notify-me hov-btn3 w-100"
                        data-product-id="@product.Id"
                        style="background-color:#333; color:#fff;">
                    <i class="zmdi zmdi-notifications-none"></i> Notify Me When Available
                </button>
            }
        </div>
    </div>
</div>