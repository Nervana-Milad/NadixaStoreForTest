@model Nadixa.Application.DTOS.ProductDetailDto

<!-- Modal1 -->
<div class="wrap-modal1 js-modal1 p-t-60 p-b-20">
	<div class="overlay-modal1 js-hide-modal1"></div>

	<div class="container">
		<div class="bg0 p-t-60 p-b-30 p-lr-15-lg how-pos3-parent">
			<button class="how-pos3 hov3 trans-04 js-hide-modal1">
				<img src="~/images/icons/icon-close.png" alt="CLOSE">
			</button>

			<div class="row">
				<div class="col-md-6 col-lg-7 p-b-30">
					<div class="p-l-25 p-r-30 p-lr-0-lg">
						<div class="wrap-slick3 flex-sb flex-w">
							<div class="wrap-slick3-dots"></div>
							<div class="wrap-slick3-arrows flex-sb-m flex-w"></div>

							<div class="slick3 gallery-lb">
								@if (!string.IsNullOrEmpty(Model.PictureUrl))
								{
									<div class="item-slick3" data-thumb="@Url.Content(Model.PictureUrl)">
										<div class="wrap-pic-w pos-relative">
											<img src="@Url.Content(Model.PictureUrl)" alt="@Model.Name">

											<a class="flex-c-m size-108 how-pos1 bor0 fs-16 cl10 bg0 hov-btn3 trans-04"
											   href="@Url.Content(Model.PictureUrl)">
												<i class="fa fa-expand"></i>
											</a>
										</div>
									</div> 

								}

								@foreach (var image in Model.GalleryImageUrls)
								{
									<div class="item-slick3" data-thumb="@Url.Content(image)">
										<div class="wrap-pic-w pos-relative">
											<img src="@Url.Content(image)" alt="@Model.Name">
											<a class="flex-c-m size-108 how-pos1 bor0 fs-16 cl10 bg0 hov-btn3 trans-04"
											   href="@Url.Content(image)">
												<i class="fa fa-expand"></i>
											</a>
										</div>
									</div> 
								}
							</div>
						</div>
					</div>
				</div>

				<div class="col-md-6 col-lg-5 p-b-30">
					<div class="p-r-50 p-t-5 p-lr-0-lg">
						<h4 class="mtext-105 cl2 js-name-detail p-b-14">
							@Model.Name
						</h4>

						<span class="mtext-106 cl2">
@if (!string.IsNullOrEmpty(Model.BadgeText))
{
    <span style="display:inline-block; background-color:@(Model.BadgeColorHex ?? "#FF3B30"); color:#fff; font-size:11px; font-weight:700; padding:3px 10px; border-radius:20px; margin-bottom:6px;">
        @Model.BadgeText
    </span>
}
<div class="d-flex align-items-center flex-wrap">
    @if (Model.DiscountedPrice != null && Model.DiscountedPrice < Model.Price)
    {
        <span class="mtext-106" style="color:#e74c3c; font-weight:700;">$ @Model.DiscountedPrice.Value.ToString("N2")</span>
        <span class="mtext-106 ml-2" style="text-decoration: line-through; color:#999; font-size: 0.75em;">
            $ @Model.Price
        </span>
    }
    else
    {
        <span class="mtext-106 cl2">$ @Model.Price</span>
    }
</div>						</span>

						<p class="stext-102 cl3 p-t-23">
							@Model.Description
						</p>

						<!--  -->
						<div class="p-t-33">
							<div class="flex-w flex-r-m p-b-10">
								<div class="size-204 flex-w flex-m respon6-next">
								
									<div class="wrap-num-product flex-w m-r-20 m-tb-10 my-3">

										<div class="btn-num-product-down cl8 hov-btn3 trans-04 flex-c-m @(Model.StockQuantity <= 0 ? "disabled-btn" : "")">
											<i class="fs-16 zmdi zmdi-minus"></i>
										</div>

										<input class="mtext-104 cl3 txt-center num-product"
											   type="number"
											   name="num-product"
											   value="@(Model.StockQuantity > 0 ? 1 : 0)"
											   min="@(Model.StockQuantity > 0 ? 1 : 0)"
											   max="@Model.StockQuantity"
											   @(Model.StockQuantity <= 0 ? "readonly" : "")>

										<div class="btn-num-product-up cl8 hov-btn3 trans-04 flex-c-m @(Model.StockQuantity <= 0 ? "disabled-btn" : "")">
											<i class="fs-16 zmdi zmdi-plus"></i>
										</div>

									</div>
									
										@if (Model.StockQuantity > 0)
										{
											<button type="button"
													class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04 js-addcart-detail my-4"
													data-product-id="@Model.Id">
												Add to cart
											</button>
										}
										else
										{
											<button type="button"
													disabled
													class="flex-c-m stext-101 cl0 size-101 bg-danger bor1 p-lr-15 trans-04 my-4"
													style="cursor:not-allowed; opacity:.7;">
												Out Of Stock
											</button>
										}	
								</div>
								

							</div>
								<h6>
								Quantity Stock: @Model.StockQuantity item(s)
								</h6>
							<p class="text-muted" style="font-size: 14px;">
								<i class="zmdi zmdi-shopping-cart"></i> @Model.SoldLastMonth sold in the last month
							</p>
						</div>

						<!--  -->
						<div class="flex-w flex-m p-l-100 p-t-40 respon7">
							

							<div class="flex-m bor9 p-r-10 m-r-11">
								
								<button class="js-addwish-detail fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2"
										data-product-id="@Model.Id" data-product-name="@Model.Name">
									<i class="zmdi zmdi-favorite-outline"></i>
								</button>
							</div>

							<a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 m-r-8 tooltip100" data-tooltip="Facebook">
								<i class="fa fa-facebook"></i>
							</a>

							<a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 m-r-8 tooltip100" data-tooltip="Twitter">
								<i class="fa fa-twitter"></i>
							</a>

							<a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 m-r-8 tooltip100" data-tooltip="Google Plus">
								<i class="fa fa-google-plus"></i>
							</a>
						</div>
					</div>
				</div>
				<div class="flex-c-m flex-w w-full p-t-45">
					<a asp-Controller="Product" asp-action="Detail" asp-route-id="@Model.Id" class="flex-c-m stext-101 cl5 size-103 bg2 bor1 hov-btn1 p-lr-15 trans-04">
						More Details 
					</a>
				</div>
			</div>
		</div>
	</div>
</div>
