@{
    ViewData["Title"] = "Help & FAQs";
}

<section class="bg-img1 txt-center p-lr-15 p-tb-92"
         style="background-image: url('/images/bg-01.jpg'); margin-top:80px">
    <h2 class="ltext-105 cl0 txt-center">
        Help & FAQs
    </h2>
</section>

<section class="bg0 p-t-75 p-b-120">
    <div class="container">

        <!-- Intro -->
        <div class="row p-b-60">
            <div class="col-12 text-center">
                <h3 class="mtext-111 cl2 p-b-16">
                    How Can We Help You?
                </h3>

                <p class="stext-113 cl6">
                    Find answers to the most common questions about orders,
                    shipping, payments, returns, and your account.
                </p>
            </div>
        </div>

        <!-- FAQ Accordion -->
        <div class="row">
            <div class="col-md-10 col-lg-8 m-lr-auto">

                <!-- Orders -->
                <div class="p-b-30">
                    <h4 class="mtext-105 cl2 p-b-20">
                        Orders
                    </h4>

                    <div class="bor10 p-lr-20 p-tb-20 m-b-15">
                        <h5 class="mtext-106 cl2 p-b-10">
                            How can I place an order?
                        </h5>

                        <p class="stext-115 cl6">
                            Browse products, add items to your cart,
                            then proceed to checkout and complete payment.
                        </p>
                    </div>

                    <div class="bor10 p-lr-20 p-tb-20 m-b-15">
                        <h5 class="mtext-106 cl2 p-b-10">
                            Can I cancel my order?
                        </h5>

                        <p class="stext-115 cl6">
                            Orders can be canceled before they are shipped.
                            Contact support as soon as possible.
                        </p>
                    </div>
                </div>

                <!-- Shipping -->
                <div class="p-b-30">
                    <h4 class="mtext-105 cl2 p-b-20">
                        Shipping
                    </h4>

                    <div class="bor10 p-lr-20 p-tb-20 m-b-15">
                        <h5 class="mtext-106 cl2 p-b-10">
                            How long does shipping take?
                        </h5>

                        <p class="stext-115 cl6">
                            Standard shipping usually takes 3–5 business days.
                        </p>
                    </div>

                    <div class="bor10 p-lr-20 p-tb-20 m-b-15">
                        <h5 class="mtext-106 cl2 p-b-10">
                            Do you offer international shipping?
                        </h5>

                        <p class="stext-115 cl6">
                            Yes, international shipping is available for
                            selected countries.
                        </p>
                    </div>
                </div>

                <!-- Payment -->
                <div class="p-b-30">
                    <h4 class="mtext-105 cl2 p-b-20">
                        Payments
                    </h4>

                    <div class="bor10 p-lr-20 p-tb-20 m-b-15">
                        <h5 class="mtext-106 cl2 p-b-10">
                            What payment methods do you accept?
                        </h5>

                        <p class="stext-115 cl6">
                            We accept Visa, MasterCard, PayPal,
                            and Cash on Delivery.
                        </p>
                    </div>

                    <div class="bor10 p-lr-20 p-tb-20 m-b-15">
                        <h5 class="mtext-106 cl2 p-b-10">
                            Is online payment secure?
                        </h5>

                        <p class="stext-115 cl6">
                            Yes, all payments are securely processed
                            using encrypted connections.
                        </p>
                    </div>
                </div>

                <!-- Returns -->
                <div class="p-b-30">
                    <h4 class="mtext-105 cl2 p-b-20">
                        Returns & Refunds
                    </h4>

                    <div class="bor10 p-lr-20 p-tb-20 m-b-15">
                        <h5 class="mtext-106 cl2 p-b-10">
                            What is your return policy?
                        </h5>

                        <p class="stext-115 cl6">
                            Products can be returned within 14 days
                            of delivery in original condition.
                        </p>
                    </div>

                    <div class="bor10 p-lr-20 p-tb-20 m-b-15">
                        <h5 class="mtext-106 cl2 p-b-10">
                            When will I receive my refund?
                        </h5>

                        <p class="stext-115 cl6">
                            Refunds are processed within 5–7 business days
                            after approval.
                        </p>
                    </div>
                </div>

                <!-- Account -->
                <div class="p-b-30">
                    <h4 class="mtext-105 cl2 p-b-20">
                        Account
                    </h4>

                    <div class="bor10 p-lr-20 p-tb-20 m-b-15">
                        <h5 class="mtext-106 cl2 p-b-10">
                            How do I create an account?
                        </h5>

                        <p class="stext-115 cl6">
                            Click Register from the top menu
                            and fill in your details.
                        </p>
                    </div>

                    <div class="bor10 p-lr-20 p-tb-20 m-b-15">
                        <h5 class="mtext-106 cl2 p-b-10">
                            I forgot my password. What should I do?
                        </h5>

                        <p class="stext-115 cl6">
                            Use the Forgot Password option
                            on the login page to reset your password.
                        </p>
                    </div>
                </div>

                <!-- Contact -->
                <div class="txt-center p-t-20">
                    <h4 class="mtext-105 cl2 p-b-15">
                        Still Need Help?
                    </h4>

                    <p class="stext-115 cl6 p-b-25">
                        Contact our support team and we’ll be happy to assist you.
                    </p>

                    <a asp-controller="Contact"
                       asp-action="Index"
                       class="flex-c-m stext-101 cl0 size-107 bg3 bor2 hov-btn3 p-lr-15 trans-04 m-auto">
                        Contact Us
                    </a>
                </div>

            </div>
        </div>

    </div>
</section>
