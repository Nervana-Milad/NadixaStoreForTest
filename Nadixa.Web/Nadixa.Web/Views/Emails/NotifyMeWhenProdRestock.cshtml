@model Nadixa.Application.DTOS.NotifyMeWhenProdRestockDto
@{
    Layout = null; // Email templates never use the site layout
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Model.ProductName is back in stock!</title>
</head>
<body style="margin:0; padding:0; background:#f8f9fb; font-family:Arial, sans-serif;">

    <div style="max-width:600px; margin:30px auto; background:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,0.08);">

        @* HEADER *@
        <div style="background:#6c7ae0; padding:32px 40px; text-align:center;">
            <h1 style="color:#ffffff; margin:0; font-size:26px; letter-spacing:2px;">NADIXA</h1>
            <p style="color:rgba(255,255,255,0.85); margin:8px 0 0; font-size:14px;">Back In Stock</p>
        </div>

        @* BODY *@
        <div style="padding:36px 40px;">

            <p style="font-size:16px; color:#2d3748; margin-top:0;">
                Hi <strong>@Model.CustomerName</strong>,
            </p>
            <p style="font-size:14px; color:#718096; line-height:1.7;">
                Good news! The item you were waiting for is back in stock and ready to order.
            </p>

            @* PRODUCT CARD *@
            <div style="background:#f8f9fb; border-radius:8px; padding:16px 20px; margin:24px 0; display:flex; align-items:center;">
                <img src="@Model.ProductImageUrl" alt="@Model.ProductName"
                     style="width:90px; height:90px; object-fit:cover; border-radius:8px; margin-right:16px;">
                <div>
                    <p style="margin:0; font-size:15px; font-weight:bold; color:#2d3748;">@Model.ProductName</p>
                    <p style="margin:6px 0 0; font-size:14px; color:#6c7ae0; font-weight:bold;">EGP @Model.Price.ToString("N0")</p>
                </div>
            </div>

            @* CTA *@
            <div style="text-align:center; margin:32px 0 8px;">
                <a href="@Model.ProductUrl"
                   style="background:#6c7ae0; color:#ffffff; text-decoration:none; padding:12px 32px; border-radius:8px; font-size:14px; font-weight:bold; display:inline-block;">
                    Shop Now
                </a>
            </div>

            <p style="font-size:13px; color:#a0aec0; text-align:center; margin-top:20px;">
                Stock is limited, so don't wait too long!
            </p>

        </div>

        @* FOOTER *@
        <div style="background:#f8f9fb; padding:20px 40px; text-align:center; border-top:1px solid #edf2f7;">
            <p style="font-size:12px; color:#a0aec0; margin:0;">
                &copy; @DateTime.Now.Year Nadixa Store. All rights reserved.
            </p>
        </div>

    </div>
</body>
</html>