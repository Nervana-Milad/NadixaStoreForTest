@model Nadixa.Web.Models.ViewModels.OrderConfirmationViewModel
@{
    Layout = null; // Email templates never use the site layout
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Order Confirmation #@Model.OrderId</title>
</head>
<body style="margin:0; padding:0; background:#f8f9fb; font-family:Arial, sans-serif;">

  <div style="max-width:600px; margin:30px auto; background:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,0.08);">
    @* HEADER *@
    <div style="background:#6c7ae0; padding:32px 40px; text-align:center;">
      <h1 style="color:#ffffff; margin:0; font-size:26px; letter-spacing:2px;">NADIXA</h1>
      <p style="color:rgba(255,255,255,0.85); margin:8px 0 0; font-size:14px;">Order Confirmation</p>
    </div>

      @* BODY *@
    <div style="padding:36px 40px;">

      <p style="font-size:16px; color:#2d3748; margin-top:0;">
        Hi <strong>@Model.CustomerName</strong>,
      </p>
      <p style="font-size:14px; color:#718096; line-height:1.7;">
        Thank you for your order! We've received it and it's now being processed.
        Here's a summary of what you ordered:
      </p>
@* ORDER INFO BOX *@
      <div style="background:#f8f9fb; border-radius:8px; padding:16px 20px; margin:24px 0;">
        <table style="width:100%; border-collapse:collapse;">
          <tr>
            <td style="font-size:13px; color:#718096; padding:4px 0;">Order Number</td>
            <td style="font-size:13px; color:#2d3748; font-weight:bold; text-align:right;">#@Model.OrderId</td>
          </tr>
          <tr>
            <td style="font-size:13px; color:#718096; padding:4px 0;">Order Date</td>
            <td style="font-size:13px; color:#2d3748; text-align:right;">@Model.OrderDate.ToString("MMMM d, yyyy")</td>
          </tr>
          <tr>
            <td style="font-size:13px; color:#718096; padding:4px 0;">Delivery Address</td>
            <td style="font-size:13px; color:#2d3748; text-align:right;">@Model.Address, @Model.City</td>
          </tr>
          <tr>
            <td style="font-size:13px; color:#718096; padding:4px 0;">Phone</td>
            <td style="font-size:13px; color:#2d3748; text-align:right;">@Model.PhoneNumber</td>
          </tr>
        </table>
      </div>
   @* ITEMS TABLE *@
      <table style="width:100%; border-collapse:collapse; font-size:14px;">
        <thead>
          <tr style="background:#f8f9fb;">
            <th style="padding:10px 12px; text-align:left;   color:#718096; font-size:12px; text-transform:uppercase; font-weight:600;">Product</th>
            <th style="padding:10px 12px; text-align:center; color:#718096; font-size:12px; text-transform:uppercase; font-weight:600;">Qty</th>
            <th style="padding:10px 12px; text-align:right;  color:#718096; font-size:12px; text-transform:uppercase; font-weight:600;">Price</th>
            <th style="padding:10px 12px; text-align:right;  color:#718096; font-size:12px; text-transform:uppercase; font-weight:600;">Total</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in Model.Items)
          {
            <tr>
              <td style="padding:10px 12px; border-bottom:1px solid #f0f0f0;"><strong>@item.ProductName</strong></td>
              <td style="padding:10px 12px; border-bottom:1px solid #f0f0f0; text-align:center;">@item.Quantity</td>
              <td style="padding:10px 12px; border-bottom:1px solid #f0f0f0; text-align:right;">EGP @item.Price.ToString("N0")</td>
              <td style="padding:10px 12px; border-bottom:1px solid #f0f0f0; text-align:right;">EGP @item.LineTotal.ToString("N0")</td>
            </tr>
          }
        </tbody>
      </table>
@* 
      {{-- ── TOTALS ── --}} *@
      <div style="margin-top:20px; padding-top:16px; border-top:2px solid #f0f0f0;">
        <table style="width:100%; font-size:14px;">
          <tr>
            <td style="color:#718096; padding:4px 0;">Subtotal</td>
            <td style="text-align:right; color:#2d3748;">EGP @Model.SubTotal.ToString("N0")</td>
          </tr>
          <tr>
            <td style="color:#718096; padding:4px 0;">Shipping Fee</td>
            <td style="text-align:right; color:#2d3748;">EGP @Model.ShippingFee.ToString("N0")</td>
          </tr>
          <tr>
            <td style="color:#2d3748; font-weight:bold; font-size:16px; padding:10px 0 4px;">Total</td>
            <td style="text-align:right; color:#6c7ae0; font-weight:bold; font-size:16px;">EGP @Model.GrandTotal.ToString("N0")</td>
          </tr>
        </table>
      </div>

@*       {{-- ── NOTES ── --}} *@
      @if (!string.IsNullOrWhiteSpace(Model.Notes))
      {
        <div style="margin-top:20px; padding:14px 16px; background:#fffbeb; border-radius:8px; border-left:3px solid #f6c90e;">
          <p style="margin:0; font-size:13px; color:#7d4a00;">
            <strong>Your notes:</strong> @Model.Notes
          </p>
        </div>
      }

@*       {{-- ── CTA ── --}} *@
      <div style="text-align:center; margin:32px 0 8px;">
        <p style="font-size:14px; color:#718096;">
          Questions about your order? Reply to this email or contact us anytime.
        </p>
      </div>

    </div>

   @*  {{-- ── FOOTER ── --}} *@
    <div style="background:#f8f9fb; padding:20px 40px; text-align:center; border-top:1px solid #edf2f7;">
      <p style="font-size:12px; color:#a0aec0; margin:0;">
        &copy; @DateTime.Now.Year Nadixa Store. All rights reserved.
      </p>
    </div>

  </div>
</body>
</html>
