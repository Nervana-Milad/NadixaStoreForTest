@model Nadixa.Web.Models.ViewModels.OrderDetailsViewModel

@{
    ViewData["Title"] = "Order Details";
}

<div class="container order-section">

    <!-- Order Header -->
    <div class="order-card">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2 class="order-title">
                Order #@Model.OrderId
            </h2>

            @{
                var statusClass = Model.Status.ToLower() switch
                {
                    "pending" => "status-pending",
                    "processing" => "status-processing",
                    "shipped" => "status-shipped",
                    "delivered" => "status-delivered",
                    "cancelled" => "status-cancelled",
                    _ => ""
                };
            }

            <span class="status-badge @statusClass">
                @Model.Status
            </span>

        </div>

        <!-- Update Status -->
        <div class="mb-4">

            <h5 class="mb-3">
                Update Order Status
            </h5>

            @if(Model.Status != "Delivered" && Model.Status != "Cancelled")
            {
                <form asp-action="UpdateStatus"
                      asp-controller="AdminOrder"
                      method="post">

                    <input type="hidden"
                           name="orderId"
                           value="@Model.OrderId" />

                    <div class="row">

                        <div class="col-md-8">
                            <select name="status"
                                    class="form-control">

                                @foreach (var status in ViewBag.Statuses)
                                {
                                    if (status == Model.Status)
                                    {
                                        <option value="@status" selected>
                                            @status
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@status">
                                            @status
                                        </option>
                                    }
                                }

                            </select>
                        </div>

                        <div class="col-md-4">
                            <button type="submit"
                                    class="btn btn-dark w-100">
                                Save Status
                            </button>
                        </div>

                    </div>

                </form>

            }
            else
            {
                <div class="alert alert-secondary">
                    This order status can no longer be changed.
                </div>
            }
        </div>

        <!-- Customer Info -->
        <div class="row">

            <div class="col-md-4 mb-3">
                <div class="info-box">
                    <div class="info-title">
                        Customer Name
                    </div>

                    <div class="info-value">
                        @Model.FullName
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="info-box">
                    <div class="info-title">
                        Phone Number
                    </div>

                    <div class="info-value">
                        @Model.Phone
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="info-box">
                    <div class="info-title">
                        Order Date
                    </div>

                    <div class="info-value">
                        @Model.CreatedAt.ToString("dd MMM yyyy")
                    </div>
                </div>
            </div>

        </div>

        <div class="info-box mt-3">
            <div class="info-title">
                Shipping Address
            </div>

            <div class="info-value">
                @Model.Address
            </div>
        </div>

    </div>

    <!-- Products -->
    <div class="order-card">

        <h3 class="mb-4">
            Products
        </h3>

        @foreach (var item in Model.Items)
        {
            <div class="product-item">

                <div class="row align-items-center">

                    <div class="col-md-2">
                        <img src="@item.ImageUrl"
                             alt="@item.ProductName"
                             class="product-image">
                    </div>

                    <div class="col-md-4">
                        <div class="product-name">
                            @item.ProductName
                        </div>
                    </div>

                    <div class="col-md-2">
                        Qty: @item.Quantity
                    </div>

                    <div class="col-md-2">
                        L.E. @item.Price
                    </div>

                    <div class="col-md-2 text-end">
                        <strong>
                            L.E. @item.Total
                        </strong>
                    </div>

                </div>

            </div>
        }

    </div>

    <!-- Summary -->
    <div class="order-card">

        <h3 class="mb-4">
            Order Summary
        </h3>

        <div class="summary-box">

            <div class="summary-row">
                <span>Subtotal</span>
                <span>L.E. @Model.SubTotal</span>
            </div>

            <div class="summary-row">
                <span>Shipping Fee</span>
                <span>L.E. @Model.ShippingFee</span>
            </div>

            <div class="summary-row total">
                <span>Total</span>
                <span>L.E. @Model.GrandTotal</span>
            </div>

        </div>

    </div>

    <div class="text-center mt-4">
        <a asp-action="Index"
           asp-controller="AdminOrder"
           class="btn btn-outline-dark">
            Back To Orders
        </a>
    </div>

</div>