@* 
@model Nadixa.Web.Models.ViewModels.OrderDetailsViewModel

@{
    ViewData["Title"] = "Order Details";
}

<div class="container order-section">

    <!-- Order Header -->
    <div class="order-card">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2 class="order-title">
                Order #@Model.OrderId
            </h2>

            @{
                var statusClass = Model.Status.ToLower() switch
                {
                    "pending" => "status-pending",
                    "processing" => "status-processing",
                    "shipped" => "status-shipped",
                    "delivered" => "status-delivered",
                    "cancelled" => "status-cancelled",
                    _ => ""
                };
            }

            <span class="status-badge @statusClass">
                @Model.Status
            </span>

        </div>

        <!-- Update Status -->
        <div class="mb-4">

            <h5 class="mb-3">
                Update Order Status
            </h5>

            @if(Model.Status != "Delivered" && Model.Status != "Cancelled")
            {
                <form asp-action="UpdateStatus"
                      asp-controller="AdminOrder"
                      method="post">

                    <input type="hidden"
                           name="orderId"
                           value="@Model.OrderId" />

                    <div class="row">

                        <div class="col-md-8">
                            <select name="status"
                                    class="form-control">

                                @foreach (var status in ViewBag.Statuses)
                                {
                                    if (status == Model.Status)
                                    {
                                        <option value="@status" selected>
                                            @status
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@status">
                                            @status
                                        </option>
                                    }
                                }

                            </select>
                        </div>

                        <div class="col-md-4">
                            <button type="submit"
                                    class="btn btn-dark w-100">
                                Save Status
                            </button>
                        </div>

                    </div>

                </form>

            }
            else
            {
                <div class="alert alert-secondary">
                    This order status can no longer be changed.
                </div>
            }
        </div>

        <!-- Customer Info -->
        <div class="row">

            <div class="col-md-4 mb-3">
                <div class="info-box">
                    <div class="info-title">
                        Customer Name
                    </div>

                    <div class="info-value">
                        @Model.FullName
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="info-box">
                    <div class="info-title">
                        Phone Number
                    </div>

                    <div class="info-value">
                        @Model.Phone
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="info-box">
                    <div class="info-title">
                        Order Date
                    </div>

                    <div class="info-value">
                        @Model.CreatedAt.ToString("dd MMM yyyy")
                    </div>
                </div>
            </div>

        </div>

        <div class="info-box mt-3">
            <div class="info-title">
                Shipping Address
            </div>

            <div class="info-value">
                @Model.Address
            </div>
        </div>

    </div>

    <!-- Products -->
    <div class="order-card">

        <h3 class="mb-4">
            Products
        </h3>

        @foreach (var item in Model.Items)
        {
            <div class="product-item">

                <div class="row align-items-center">

                    <div class="col-md-2">
                        <img src="@item.ImageUrl"
                             alt="@item.ProductName"
                             class="product-image">
                    </div>

                    <div class="col-md-4">
                        <div class="product-name">
                            @item.ProductName
                        </div>
                    </div>

                    <div class="col-md-2">
                        Qty: @item.Quantity
                    </div>

                    <div class="col-md-2">
                        L.E. @item.Price
                    </div>

                    <div class="col-md-2 text-end">
                        <strong>
                            L.E. @item.Total
                        </strong>
                    </div>

                </div>

            </div>
        }

    </div>

    <!-- Summary -->
    <div class="order-card">

        <h3 class="mb-4">
            Order Summary
        </h3>

        <div class="summary-box">

            <div class="summary-row">
                <span>Subtotal</span>
                <span>L.E. @Model.SubTotal</span>
            </div>

            <div class="summary-row">
                <span>Shipping Fee</span>
                <span>L.E. @Model.ShippingFee</span>
            </div>

            <div class="summary-row total">
                <span>Total</span>
                <span>L.E. @Model.GrandTotal</span>
            </div>

        </div>

    </div>

    <div class="text-center mt-4">
        <a asp-action="Index"
           asp-controller="AdminOrder"
           class="btn btn-outline-dark">
            Back To Orders
        </a>
    </div>

</div> *@
@model Nadixa.Web.Models.ViewModels.OrderDetailsViewModel

@{
    ViewData["Title"] = "Order Details";
    var statusLower = Model.Status.ToLower();
    var statusClass = statusLower switch
    {
        "pending" => "status-pending",
        "processing" => "status-processing",
        "shipped" => "status-shipped",
        "delivered" => "status-delivered",
        "cancelled" => "status-cancelled",
        _ => ""
    };
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container details-section">

    <!-- Breadcrumb / Back --}}
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="font-size:24px;">
                <i class="fa-solid fa-receipt me-2 text-muted" style="font-size:20px;"></i>
                Order #@Model.OrderId
            </h2>
            <p class="text-muted mb-0 small">
                Placed on @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
            </p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="status-badge @statusClass fs-13">@Model.Status</span>
            <a asp-action="Index" asp-controller="AdminOrder"
               class="btn btn-back">
                <i class="fa-solid fa-arrow-left me-2"></i>Back to Orders
            </a>
        </div>
    </div>

    <div class="row g-4">

        <!-- LEFT COLUMN  -->
    <div class="col-lg-8">

        {{!-- Customer Info Card --}}
        <div class="detail-card mb-4">
            <div class="detail-card-header">
                <i class="fa-regular fa-user me-2"></i> Customer Information
            </div>
            <div class="detail-card-body">
                <div class="row g-3">
                    <div class="col-sm-4">
                        <div class="info-label">Full Name</div>
                        <div class="info-val">@Model.FullName</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="info-label">Phone</div>
                        <div class="info-val">
                            <i class="fa-solid fa-phone me-1 text-muted" style="font-size:12px;"></i>
                            @Model.Phone
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="info-label">Order Date</div>
                        <div class="info-val">@Model.CreatedAt.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="col-12">
                        <div class="info-label">Shipping Address</div>
                        <div class="info-val">
                            <i class="fa-solid fa-location-dot me-1 text-muted" style="font-size:12px;"></i>
                            @Model.Address
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {{!-- Products Card --}}
        <div class="detail-card">
            <div class="detail-card-header">
                <i class="fa-solid fa-bag-shopping me-2"></i> Order Items
            </div>
            <div class="detail-card-body p-0">
                <table class="table items-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4" colspan="2">Product</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end pe-4">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4" style="width:70px;">
                                    <img src="@item.ImageUrl"
                                         alt="@item.ProductName"
                                         class="item-img">
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark" style="font-size:14px;">
                                        @item.ProductName
                                    </div>
                                </td>
                                <td class="text-center text-muted" style="font-size:14px;">
                                    @item.Quantity
                                </td>
                                <td class="text-end text-muted" style="font-size:14px;">
                                    L.E. @item.Price
                                </td>
                                <td class="text-end pe-4">
                                    <strong style="font-size:14px; color:#0f172a;">
                                        L.E. @item.Total
                                    </strong>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- RIGHT COLUMN  -->
    <div class="col-lg-4">

        {{!-- Update Status Card --}}
        <div class="detail-card mb-4">
            <div class="detail-card-header">
                <i class="fa-solid fa-pen-to-square me-2"></i> Update Status
            </div>
            <div class="detail-card-body">
                @if (statusLower != "delivered" && statusLower != "cancelled")
                {
                    <form asp-action="UpdateStatus"
                          asp-controller="AdminOrder"
                          method="post">
                        <input type="hidden" name="orderId" value="@Model.OrderId" />

                        <div class="mb-3">
                            <label class="info-label mb-1">Current Status</label>
                            <span class="status-badge @statusClass d-inline-flex">@Model.Status</span>
                        </div>

                        <div class="mb-3">
                            <label class="info-label mb-1">Change To</label>
                            <select name="newStatus"
                                    class="form-select filter-select">
                                <option value="" disabled selected>Select new status...</option>
                                @if (statusLower == "pending")
                                {
                                    <option value="Processing">Processing</option>
                                    <option value="Cancelled">Cancelled</option>
                                }
                                else if (statusLower == "processing")
                                {
                                    <option value="Shipped">Shipped</option>
                                    <option value="Cancelled">Cancelled</option>
                                }
                                else if (statusLower == "shipped")
                                {
                                    <option value="Delivered">Delivered</option>
                                }
                            </select>
                        </div>

                        <button type="submit" class="btn btn-save w-100">
                            <i class="fa-solid fa-floppy-disk me-2"></i> Save Status
                        </button>
                    </form>
                }
                else
                {
                    <div class="lifecycle-ended">
                        <i class="fa-solid fa-lock mb-2" style="font-size:20px; color:#94a3b8;"></i>
                        <p class="mb-0 text-muted small">
                            This order's lifecycle has ended and its status can no longer be changed.
                        </p>
                    </div>
                }
            </div>
        </div>

        {{!-- Order Summary Card --}}
        <div class="detail-card">
            <div class="detail-card-header">
                <i class="fa-solid fa-file-invoice-dollar me-2"></i> Order Summary
            </div>
            <div class="detail-card-body">
                <div class="summary-row">
                    <span class="text-muted">Subtotal</span>
                    <span>L.E. @Model.SubTotal</span>
                </div>
                <div class="summary-row">
                    <span class="text-muted">Shipping Fee</span>
                    <span>L.E. @Model.ShippingFee</span>
                </div>
                <hr class="my-3" style="border-color:#f1f5f9;">
                <div class="summary-row total-row">
                    <span>Grand Total</span>
                    <span>L.E. @Model.GrandTotal.ToString("N0")</span>
                </div>
            </div>
        </div>

    </div>
</div>

</div>

<style>
    body {
        background-color: #f8fafc;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .details-section {
        margin-top: 40px;
        padding-bottom: 60px;
    }

    /* ── Cards ── */
    .detail-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #f1f5f9;
        box-shadow: 0 4px 18px rgba(0,0,0,0.02);
        overflow: hidden;
    }

    .detail-card-header {
        padding: 16px 24px;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #475569;
        background-color: #f8fafc;
        border-bottom: 1px solid #f1f5f9;
    }

    .detail-card-body {
        padding: 24px;
    }

    /* ── Info fields ── */
    .info-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #94a3b8;
        margin-bottom: 4px;
    }

    .info-val {
        font-size: 14px;
        font-weight: 600;
        color: #0f172a;
    }

    /* ── Items table ── */
    .items-table thead th {
        background-color: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        color: #475569;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 14px 12px;
    }

    .items-table tbody td {
        padding: 16px 12px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .item-img {
        width: 52px;
        height: 52px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #f1f5f9;
    }

    /* ── Status badges — same as Index page ── */
    .status-badge {
        height: 28px;
        padding: 0 14px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
    }

    .status-pending {
        background-color: #fffbeb;
        color: #b45309;
    }

    .status-processing {
        background-color: #eff6ff;
        color: #1d4ed8;
    }

    .status-shipped {
        background-color: #f0fdf4;
        color: #15803d;
    }

    .status-delivered {
        background-color: #f0fdf4;
        color: #16a34a;
    }

    .status-cancelled {
        background-color: #fef2f2;
        color: #b91c1c;
    }

    /* ── Summary ── */
    .summary-row {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        padding: 6px 0;
        color: #334155;
    }

    .total-row {
        font-size: 16px;
        font-weight: 700;
        color: #0f172a;
    }

    /* ── Lifecycle ended box ── */
    .lifecycle-ended {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 20px 10px;
        gap: 6px;
    }

    /* ── Buttons ── */
    .btn-back {
        height: 38px;
        padding: 0 18px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #334155;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s;
    }

        .btn-back:hover {
            background: #0f172a;
            color: #ffffff;
            border-color: #0f172a;
        }

    .btn-save {
        height: 42px;
        font-size: 13px;
        font-weight: 700;
        border-radius: 8px;
        background: #0f172a;
        color: #ffffff;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

        .btn-save:hover {
            background: #1e293b;
            color: #ffffff;
        }

    /* ── Form controls — same look as Index page ── */
    .filter-select {
        height: 42px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        font-size: 14px;
        color: #475569;
        cursor: pointer;
    }

        .filter-select:focus {
            border-color: #1b61ff;
            box-shadow: 0 0 0 3px rgba(27,97,255,0.12);
        }

    .fs-13 {
        font-size: 13px !important;
    }
</style>
