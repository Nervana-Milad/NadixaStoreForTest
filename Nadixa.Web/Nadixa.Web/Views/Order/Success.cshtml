@{
    ViewData["Title"] = "Order Successful";
}


<style>
    .email-confirmation-note {
        font-size: 0.9rem;
        color: #718096;
        background-color: #f8f9fb;
        border-radius: 8px;
        padding: 10px 16px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 12px 0 20px;
    }
</style>


<div class="container">
    <div class="row justify-content-center">
        <div class="col-12">
            
            <div class="success-card">
                
                <!-- علامة الصح -->
                <div class="success-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                </div>

                <!-- رسالة الشكر -->
                <h2 class="success-title">
                    Thank you, @ViewBag.CustomerName!
                </h2>
                
                <p class="success-subtitle">
                    Your order has been placed successfully.<br/>
                     We've sent a confirmation email with your order details. Please check your inbox (and your Spam folder if you don't see it). 

                </p>
                <!-- 👇 تأكيد إرسال الإيميل -->
                <p class="email-confirmation-note">
                    <i class="zmdi zmdi-email"></i>
                    A confirmation email with your order details has been sent to your inbox.
                </p>
                <!-- تفاصيل الطلب -->
                <div class="order-info-box">
                    <div class="order-info-row">
                        <span class="info-label">Order Number</span>
                        <span class="info-value">#@ViewBag.OrderId</span>
                    </div>
                    
                    <hr style="border-color: #e5e5ea; margin: 12px 0;">
                    
                    <div class="order-info-row">
                        <span class="info-label">Estimated Delivery</span>
                        <span class="info-value">3 - 5 Days</span>
                    </div>
                </div>

                <!-- زرار العودة -->
                <a asp-controller="Product" asp-action="Index" class="btn-premium-dark hov-btn3">
                    Continue Shopping
                </a>

                <a asp-controller="Order"
                   asp-action="Details"
                   asp-route-id="@ViewBag.OrderId"
                   class="btn-track-order hov-btn3">

                    Track Your Order

                </a>
            </div>

        </div>
    </div>
</div>