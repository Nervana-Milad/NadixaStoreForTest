@model Nadixa.Web.Models.ViewModels.OrderDetailsViewModel

@{
    ViewData["Title"] = "Order Details";
}

<div class="container order-section">

    <!-- Header -->
    <div class="order-card">

        <div class="d-flex justify-content-between align-items-center flex-wrap">

            <div>
                <h2 class="order-title">
                    Order #@Model.OrderId
                </h2>

                <p class="text-muted mb-0">
                    Placed on
                    @Model.CreatedAt.ToString("dd MMM yyyy")
                </p>
            </div>

            @{
                var statusClass = Model.Status.ToLower() switch
                {
                    "pending" => "status-pending",
                    "processing" => "status-processing",
                    "shipped" => "status-shipped",
                    "delivered" => "status-delivered",
                    "cancelled" => "status-cancelled",
                    _ => ""
                };
            }

            <span class="status-badge @statusClass">
                @Model.Status
            </span>
            @if (Model.Status == "Pending" || Model.Status == "Processing")
            {
                <button type="button"
                        class="btn btn-danger mt-3 hov-btn3 cancel-order-btn">
                    Cancel Order
                </button>
            }
            
        </div>

    </div>

    <!-- Customer Info -->
    <div class="row">

        <div class="col-md-4 mb-4">

            <div class="info-box">

                <div class="info-title">
                    Full Name
                </div>

                <div class="info-value">
                    @Model.FullName
                </div>

            </div>

        </div>

        <div class="col-md-4 mb-4">

            <div class="info-box">

                <div class="info-title">
                    Phone Number
                </div>

                <div class="info-value">
                    @Model.Phone
                </div>

            </div>

        </div>

        <div class="col-md-4 mb-4">

            <div class="info-box">

                <div class="info-title">
                    Shipping Address
                </div>

                <div class="info-value">
                    @Model.Address
                </div>

            </div>

        </div>

    </div>

    <!-- Products -->
    <div class="order-card">

        <h3 class="mb-4">
            Ordered Products
        </h3>

        @foreach (var item in Model.Items)
        {
            <div class="product-item">

                <div class="row align-items-center">

                    <div class="col-md-2">

                        <img src="@item.ImageUrl"
                             class="product-image"
                             alt="@item.ProductName" />

                    </div>

                    <div class="col-md-4">

                        <div class="product-name">
                            @item.ProductName
                        </div>

                    </div>

                    <div class="col-md-2">

                        <div class="product-meta">
                            Qty: @item.Quantity
                        </div>

                    </div>

                    <div class="col-md-2">

                        <div class="product-meta">
                            L.E. @item.Price
                        </div>

                    </div>

                    <div class="col-md-2 text-end">

                        <strong>
                            L.E. @item.Total
                        </strong>

                    </div>

                </div>

            </div>
        }

    </div>

    <!-- Summary -->
    <div class="row justify-content-end">

        <div class="col-md-5">

            <div class="summary-box">

                <div class="summary-row">
                    <span>TotalPrice</span>

                    <span>
                        L.E. @Model.SubTotal
                    </span>
                </div>

                <div class="summary-row">
                    <span>Shipping</span>

                    <span>
                        L.E. @Model.ShippingFee
                    </span>
                </div>

                <div class="summary-row total">

                    <span>Total</span>

                    <span>
                        L.E. @Model.GrandTotal
                    </span>

                </div>


            </div>

        </div>

    </div>
    <!-- Cancel Order Form (hidden) -->
    <form id="cancelOrderConfirm"
          asp-controller="Order"
          asp-action="CancelOrder"
          asp-route-id="@Model.OrderId"
          method="post">
    </form>
</div>
