@model Nadixa.Web.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}



<section style="background-color: #E6E6E6; margin-top: 80px">
    <div class="container">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-lg-8 col-xl-6">
                <div class="card rounded-3">
                    <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-registration/img3.webp"
                         class="w-100" style="border-top-left-radius: .3rem; border-top-right-radius: .3rem;"
                         alt="Sample photo">
                    <div class="card-body p-4 p-md-5">
                        <h3 class="mb-4 pb-2 pb-md-0 mb-md-5 px-md-2">Login</h3>

                        <form class="px-md-2" asp-controller="Auth" asp-action="Login" method="post">
                            <div class="validation-summary">
                                <div asp-validation-summary="All" class="text-danger"></div>
                            </div>
                            <div class="mb-4">
                                <div data-mdb-input-init class="form-outline datepicker">
                                    <label asp-for="Email" class="form-label required"></label>
                                    <input class="form-control" type="email" asp-for="Email" placeholder="example@gmail.com" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <div data-mdb-input-init class="form-outline datepicker">
                                    <label asp-for="Password" class="form-label required"></label>
                                    <input class="form-control" asp-for="Password" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                            </div>                            
                            <button type="submit" class="btn text-white btn-lg mb-1" style="background: #6c7ae0">Login</button>

                            

                        <div class="mt-3 d-flex justify-content-end w-100">
                            <a asp-controller="Auth" asp-action="GoogleLogin" class="google-link">
                                Use Google
                            </a>
                        </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
