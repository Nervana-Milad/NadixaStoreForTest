@{
    ViewData["Title"] = "Check Email";
}
<section style="background-color: #E6E6E6; margin-top: 80px">
    <div class="container">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-lg-8 col-xl-6">
                <div class="card rounded-3">
                    <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-registration/img3.webp"
                         class="w-100" style="border-top-left-radius: .3rem; border-top-right-radius: .3rem;"
                         alt="Sample photo">
                    <div class="card-body p-4 p-md-5 text-center">
                        <div class="mb-4" style="font-size: 50px;">📩</div>
                        <h3 class="mb-3 pb-2 px-md-2">Check your email</h3>
                        <p class="text-muted mb-4">
                            If the email exists, a reset link has been sent.
                        </p>
                        <a asp-controller="Auth" asp-action="Login"
                           class="btn text-white w-100 py-2 fw-semibold"
                           style="background: linear-gradient(135deg, #6c7ae0, #a78bfa); border:none; border-radius:8px;">
                            Back to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>