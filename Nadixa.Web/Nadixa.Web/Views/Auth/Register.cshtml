@model Nadixa.Web.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<section style="background-color: #E6E6E6; margin-top: 80px">
    <div class="container">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-lg-8 col-xl-6">
                <div class="card rounded-3">
                    <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-registration/img3.webp"
                         class="w-100" style="border-top-left-radius: .3rem; border-top-right-radius: .3rem;"
                         alt="Sample photo">
                    <div class="card-body p-4 p-md-5">
                        <h3 class="mb-4 pb-2 pb-md-0 mb-md-5 px-md-2">Registration Info</h3>

                        <form class="px-md-2" asp-controller="Auth" asp-action="Register" method="post">
                            @* <div class="validation-summary">
                                <div asp-validation-summary="All" class="text-danger"></div>
                            </div> *@
                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <div data-mdb-input-init class="form-outline datepicker">
                                        <label asp-for="FirstName" class="form-label required">First Name</label>
                                        <input asp-for="FirstName" class="form-control" />
                                        <span asp-validation-for="FirstName" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-md-6 mb-4">
                                    <div data-mdb-input-init class="form-outline datepicker">
                                        <label asp-for="LastName" class="form-label required">Last Name</label>
                                        <input asp-for="LastName" class="form-control" />
                                        <span asp-validation-for="LastName" class="text-danger"></span>

                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <div data-mdb-input-init class="form-outline datepicker">
                                    <label asp-for="Email" class="form-label required"></label>
                                    <input class="form-control" type="email" asp-for="Email" placeholder="example@gmail.com"/>
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <div data-mdb-input-init class="form-outline datepicker">
                                    <label asp-for="Password" class="form-label required"></label>
                                    <input class="form-control" asp-for="Password" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mb-4">
                                <div data-mdb-input-init class="form-outline datepicker">
                                    <label asp-for="ConfirmPassword" class="form-label required">Confirm Password</label>
                                    <input class="form-control" asp-for="ConfirmPassword" />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>
                          

                            <button type="submit" class="btn text-white btn-lg mb-1" style="background: #6c7ae0">Register</button>

                        </form>
                        <div class="mt-3 d-flex justify-content-start w-100">
                            <a asp-controller="Auth"
                               asp-action="GoogleLogin"
                               class="btn border d-flex align-items-center gap-2 px-4 py-2 shadow-sm"
                               style="background-color:white; color:#444; border-radius:8px; font-weight:500;">

                                <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
                                     alt="Google"
                                     style="width:20px; height:20px;" />

                                <span>Continue with Google</span>
                            </a>
                        </div>
                        @* <div class="mt-3 d-flex justify-content-end w-100">
                            <a asp-controller="Auth" asp-action="GoogleLogin" class="google-link">
                                Continue with Google
                            </a>
                        </div>          *@
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}