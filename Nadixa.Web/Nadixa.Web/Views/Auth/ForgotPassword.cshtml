@model Nadixa.Web.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<section style="background-color: #E6E6E6; margin-top: 80px">
    <div class="container">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-lg-8 col-xl-6">
                <div class="card rounded-3">

                    <div class="card-body p-4 p-md-5">
                        <h3 class="mb-4">Forgot Password</h3>

                        <form asp-controller="Auth" asp-action="ForgotPassword" method="post">

                            <div asp-validation-summary="All" class="text-danger"></div>

                            <div class="mb-4">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" placeholder="example@gmail.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <button type="submit"
                                    class="btn text-white btn-lg w-100"
                                    style="background:#6c7ae0">
                                Send Reset Link
                            </button>

                            @if (ViewBag.ResetLink != null)
                            {
                                <div class="mt-3">
                                    <p>Test Link:</p>
                                    <a href="@ViewBag.ResetLink">Click here to reset password</a>
                                </div>
                            }

                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}