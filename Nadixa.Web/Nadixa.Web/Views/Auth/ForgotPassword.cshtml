@model Nadixa.Web.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}
<section style="background-color: #E6E6E6; margin-top: 80px">
    <div class="container">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-lg-8 col-xl-6">
                <div class="card rounded-3">
                    <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-registration/img3.webp"
                         class="w-100" style="border-top-left-radius: .3rem; border-top-right-radius: .3rem;"
                         alt="Sample photo">
                    <div class="card-body p-4 p-md-5">
                        <h3 class="mb-4 pb-2 pb-md-0 mb-md-5 px-md-2">Forgot Password</h3>
                        <form class="px-md-2" asp-controller="Auth" asp-action="ForgotPassword" method="post">
                            <div asp-validation-summary="All" class="text-danger"></div>
                            <div class="mb-4">
                                <label asp-for="Email" class="form-label required"></label>
                                <input asp-for="Email" class="form-control" placeholder="example@gmail.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <button type="submit"
                                    class="btn text-white w-100 py-2 fw-semibold mb-3"
                                    style="background: linear-gradient(135deg, #6c7ae0, #a78bfa); border:none; border-radius:8px;">
                                Send Reset Link
                            </button>

                            <div class="text-center">
                                <a asp-controller="Auth" asp-action="Login"
                                   style="color:#6c7ae0; font-size:13px">
                                    Back to Login
                                </a>
                            </div>

                            @if (ViewBag.ResetLink != null)
                            {
                                <div class="mt-3">
                                    <p>Test Link:</p>
                                    <a href="@ViewBag.ResetLink">Click here to reset password</a>
                                </div>
                            }
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}