@model Nadixa.Web.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}
<section style="background-color: #E6E6E6; margin-top: 80px">
    <div class="container">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-lg-8 col-xl-6">
                <div class="card rounded-3">
                    <div class="card-body p-4 p-md-5">
                        <h3 class="mb-4">Reset Password</h3>
                        <form asp-controller="Auth" asp-action="ResetPassword" method="post">
                            <div asp-validation-summary="All" class="text-danger"></div>
                            <input type="hidden" asp-for="Email" />
                            <input type="hidden" asp-for="Token" />
                            <div class="mb-4">
                                <label asp-for="Password" class="form-label"></label>
                                <div style="position:relative;">
                                    <input asp-for="Password" class="form-control" id="passwordInput" style="padding-right: 45px;" />
                                    <button type="button"
                                            id="togglePassword"
                                            style="position:absolute; top:50%; right:12px; transform:translateY(-50%); background:none; border:none; padding:0; color:#888; cursor:pointer; display:none;">
                                        <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <div style="position:relative;">
                                    <input asp-for="ConfirmPassword" class="form-control" id="confirmPasswordInput" style="padding-right: 45px;" />
                                    <button type="button"
                                            id="toggleConfirmPassword"
                                            style="position:absolute; top:50%; right:12px; transform:translateY(-50%); background:none; border:none; padding:0; color:#888; cursor:pointer; display:none;">
                                        <i class="bi bi-eye" id="toggleConfirmPasswordIcon"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                            <button type="submit"
                                    class="btn text-white btn-lg w-100"
                                    style="background:#6c7ae0">
                                Reset Password
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        setupPasswordToggle('passwordInput', 'togglePassword', 'togglePasswordIcon');
        setupPasswordToggle('confirmPasswordInput', 'toggleConfirmPassword', 'toggleConfirmPasswordIcon');
    </script>
}