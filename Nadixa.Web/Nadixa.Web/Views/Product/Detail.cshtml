@model Nadixa.Web.Models.ViewModels.ProductDetailViewModel

@{
	ViewData["Title"] = Model.Product.Name;
}

<style>
	.color-circle {
		width: 28px;
		height: 28px;
		border-radius: 50%;
		display: inline-block;
		border: 1px solid #ccc;
	}

	.review-card{
    background: #fff;
    padding: 20px;
    border-radius: 12px;
    border: 1px solid #eee;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    margin-bottom: 20px;
    transition: all .25s ease;
}

.review-card:hover{
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.12);
}

</style>

<!-- breadcrumb -->
<div class="container" style="margin-top:80px">
	<div class="bread-crumb flex-w p-l-25 p-r-15 p-t-30 p-lr-0-lg">
		<a asp-action="Index" asp-controller="Home" class="stext-109 cl8 hov-cl1 trans-04">
			Home
			<i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
		</a>

		<a href="product.html" class="stext-109 cl8 hov-cl1 trans-04">
			@Model.Product.Category.Name
			<i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
		</a>

		<span class="stext-109 cl4">
			@Model.Product.Name
		</span>
	</div>
</div>


<!-- Product Detail -->
<section class="sec-product-detail bg0 p-t-25 p-b-60">
	<div class="container">
		
		@if (User.IsInRole("Admin"))
		{
			<div class="d-flex text-end mb-4">
				<a class="btn btn-primary mx-2 my-3" asp-controller="Product" asp-action="Edit" asp-route-id="@Model.Product.Id">Edit Product</a>
				<button class="btn btn-danger mx-2 my-3" data-bs-toggle="modal" data-bs-target="#deleteModal">Delete Product</button>
			</div>
		}
		<div class="row">
			<div class="col-md-6 col-lg-7 p-b-30">
				<div class="p-l-25 p-r-30 p-lr-0-lg">
					<div class="wrap-slick3 flex-sb flex-w">
						<div class="wrap-slick3-dots"></div>
						<div class="wrap-slick3-arrows flex-sb-m flex-w"></div>

						<div class="slick3 gallery-lb">
							@if (!string.IsNullOrEmpty(Model.Product.MainImageUrlPath))
							{
								<div class="item-slick3" data-thumb="@Url.Content(Model.Product.MainImageUrlPath)">
									<div class="wrap-pic-w pos-relative">
										<img src="@Url.Content(Model.Product.MainImageUrlPath)" alt="@Model.Product.Name">
										<a class="flex-c-m size-108 how-pos1 bor0 fs-16 cl10 bg0 hov-btn3 trans-04"
										   href="@Url.Content(Model.Product.MainImageUrlPath)">
											<i class="fa fa-expand"></i>
										</a>
									</div>
								</div>
							}


							@foreach (var image in Model.ImageUrls)
							{
								<div class="item-slick3" data-thumb="@Url.Content(image)">
									<div class="wrap-pic-w pos-relative">
										<img src="@Url.Content(image)" alt="@Model.Product.Name">
										<a class="flex-c-m size-108 how-pos1 bor0 fs-16 cl10 bg0 hov-btn3 trans-04"
										   href="@Url.Content(image)">
											<i class="fa fa-expand"></i>
										</a>
									</div>
								</div>
							}


						</div>
					</div>
				</div>
			</div>

			<div class="col-md-6 col-lg-5 p-b-30">
				<div class="p-r-50 p-t-5 p-lr-0-lg">
					<h4 class="mtext-105 cl2 js-name-detail">
						@Model.Product.Name
					</h4>

					<p class="stext-102 cl3 py-3">
						@Model.Product.Description
					</p>

					<span class="mtext-106 cl2">
						$ @Model.Product.Price
					</span>
					<div>
						<del>
							$ @Model.Product.OldPrice
						</del>
					</div>

					

					<!--  -->
					<div class="p-t-33">
						<div class="flex-w flex-r-m p-b-10">
							<div class="size-203 flex-c-m respon6">
								Size
							</div>

							<div class="size-204 respon6-next">
								<div class="rs1-select2 bor8 bg0">
									<select class="js-select2" name="time">
										<option>Choose an option</option>
										<option>Size S</option>
										<option>Size M</option>
										<option>Size L</option>
										<option>Size XL</option>
									</select>
									<div class="dropDownSelect2"></div>
								</div>
							</div>
						</div>

						<div class="flex-w flex-l-m p-b-10">
							<div class="size-203 flex-c-m respon6">
								Color
							</div>

							@* <div class="d-flex gap-2">
								@foreach (var pc in Model.ProductColors)
								{
									<span style="
										display:inline-block;
										width:25px;
										height:25px;
										border-radius:50%;
										background:@pc.Color.HexCode;">
									</span>
								}

							</div> *@
						</div>

						<div class="flex-w flex-l-m p-b-10">
							<div class="size-204 flex-w flex-m respon6-next">
								<div class="wrap-num-product flex-w m-r-20 m-tb-10 my-3">
									<div class="btn-num-product-down cl8 hov-btn3 trans-04 flex-c-m">
										<i class="fs-16 zmdi zmdi-minus"></i>
									</div>

									<input class="mtext-104 cl3 txt-center num-product" type="number" name="num-product" value="1">

									<div class="btn-num-product-up cl8 hov-btn3 trans-04 flex-c-m">
										<i class="fs-16 zmdi zmdi-plus"></i>
									</div>
								</div>

								@if (User.Identity.IsAuthenticated)
								{
									<button type="button"
											class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04 js-addcart-detail my-4"
											data-product-id="@Model.Product.Id">
										Add to cart
									</button>
								}
								else
								{
									<a asp-action="Login" asp-controller="Auth" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
										Add to cart
									</a>
								}

							</div>
						</div>
						<h4>Quantity Stock: @Model.Product.StockQuantity</h4>
					</div>

					<!--  -->
					<div class="flex-w flex-m p-l-100 p-t-40 respon7">
						<div class="flex-m bor9 p-r-10 m-r-11">
							@* <a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 js-addwish-detail tooltip100" data-tooltip="Add to Wishlist">
								<i class="zmdi zmdi-favorite"></i>
							</a> *@
							<button class="js-addwish-detail fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 wishlist-btn"
									data-product-id="@Model.Product.Id" data-product-name="@Model.Product.Name">
								<i class="zmdi zmdi-favorite"></i>
							</button>
						</div>

						<a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 m-r-8 tooltip100" data-tooltip="Facebook">
							<i class="fa fa-facebook"></i>
						</a>

						<a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 m-r-8 tooltip100" data-tooltip="Twitter">
							<i class="fa fa-twitter"></i>
						</a>

						<a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 m-r-8 tooltip100" data-tooltip="Google Plus">
							<i class="fa fa-google-plus"></i>
						</a>
					</div>
				</div>
			</div>
		</div>

		

		<div class="bor10 m-t-50 p-t-43 p-b-40">
			<!-- Tab01 -->
			<div class="tab01">
				<!-- Nav tabs -->
				<ul class="nav nav-tabs" role="tablist">
					<li class="nav-item p-b-10">
						<a class="nav-link active" data-toggle="tab" href="#description" role="tab">Description</a>
					</li>

					<li class="nav-item p-b-10">
						<a class="nav-link" data-toggle="tab" href="#information" role="tab">Additional information</a>
					</li>

					<li class="nav-item p-b-10">
						<a class="nav-link" data-toggle="tab" href="#reviews" role="tab">Reviews (@Model.Product.Reviews.Count())</a>
					</li>
				</ul>

				<!-- Tab panes -->
				<div class="tab-content p-t-43">
					<!-- - -->
					<div class="tab-pane fade show active" id="description" role="tabpanel">
						<div class="how-pos2 p-lr-15-md">
							<p class="stext-102 cl6">
								Aenean sit amet gravida nisi. Nam fermentum est felis, quis feugiat nunc fringilla sit amet. Ut in blandit ipsum. Quisque luctus dui at ante aliquet, in hendrerit lectus interdum. Morbi elementum sapien rhoncus pretium maximus. Nulla lectus enim, cursus et elementum sed, sodales vitae eros. Ut ex quam, porta consequat interdum in, faucibus eu velit. Quisque rhoncus ex ac libero varius molestie. Aenean tempor sit amet orci nec iaculis. Cras sit amet nulla libero. Curabitur dignissim, nunc nec laoreet consequat, purus nunc porta lacus, vel efficitur tellus augue in ipsum. Cras in arcu sed metus rutrum iaculis. Nulla non tempor erat. Duis in egestas nunc.
							</p>
						</div>
					</div>

					<!-- - -->
					<div class="tab-pane fade" id="information" role="tabpanel">
						<div class="row">
							<div class="col-sm-10 col-md-8 col-lg-6 m-lr-auto">
								<ul class="p-lr-28 p-lr-15-sm">
									<li class="flex-w flex-t p-b-7">
										<span class="stext-102 cl3 size-205">
											Weight
										</span>

										<span class="stext-102 cl6 size-206">
											0.79 kg
										</span>
									</li>

									<li class="flex-w flex-t p-b-7">
										<span class="stext-102 cl3 size-205">
											Dimensions
										</span>

										<span class="stext-102 cl6 size-206">
											110 x 33 x 100 cm
										</span>
									</li>

									<li class="flex-w flex-t p-b-7">
										<span class="stext-102 cl3 size-205">
											Materials
										</span>

										<span class="stext-102 cl6 size-206">
											60% cotton
										</span>
									</li>

									<li class="flex-w flex-t p-b-7">
										<span class="stext-102 cl3 size-205">
											Color
										</span>

										<span class="stext-102 cl6 size-206">
											Black, Blue, Grey, Green, Red, White
										</span>
									</li>

									<li class="flex-w flex-t p-b-7">
										<span class="stext-102 cl3 size-205">
											Size
										</span>

										<span class="stext-102 cl6 size-206">
											XL, L, M, S
										</span>
									</li>
								</ul>
							</div>
						</div>
					</div>

					<!-- - -->
					<div class="tab-pane fade" id="reviews" role="tabpanel">
						<div class="row">
							<div class="col-sm-10 col-md-8 col-lg-6 m-lr-auto">
								<div class="p-b-30 m-lr-15-sm">
									<!-- Review -->
									@if (Model.Product.Reviews.Any())
									{
										<div id="reviewSection">
											@foreach (var review in Model.Product.Reviews)
											{
												<div class="flex-w flex-t p-b-68 review-card">
													<div class="wrap-pic-s size-109 bor0 of-hidden m-r-18 m-t-6">
														<img src="~/images/avatar-01.jpg" alt="AVATAR">
													</div>

													<div class="size-207">
														<div class="flex-w flex-sb-m p-b-17">
															<span class="mtext-107 cl2 p-r-20">
																@review.UserName
															</span>

															<span class="fs-18 cl11">

																@{
																	int fullStars = review.Rating;
																	int emptyStars = 5 - fullStars;
																}

																@for (int i = 0; i < fullStars; i++)
																{
																	<i class="zmdi zmdi-star"></i>
																}

																@for (int i = 0; i < emptyStars; i++)
																{
																	<i class="zmdi zmdi-star-outline"></i>
																}

															</span>
														</div>

														<p class="stext-102 cl6">
															@review.Content
														</p>
													</div>
												</div>
											}


										</div>
									}
									else
									{
										<p class="text-muted mb-3 text-center">No Reviews yet, Be the first to Review</p>

									}

									@if (User.Identity.IsAuthenticated)
									{
										<!-- Add review -->
										<h5 class="mtext-108 cl2 p-b-7">
											Add a review
										</h5>

										<form id="reviewForm"  method="post" class="w-full">

											<div class="flex-w flex-m p-t-50 p-b-23 form-group">
												<span class="stext-102 cl3 m-r-16">
													Your Rating
												</span>

												<span class="wrap-rating fs-18 cl11 pointer">

													<i class="item-rating pointer zmdi zmdi-star-outline" data-value="1"></i>
													<i class="item-rating pointer zmdi zmdi-star-outline" data-value="2"></i>
													<i class="item-rating pointer zmdi zmdi-star-outline" data-value="3"></i>
													<i class="item-rating pointer zmdi zmdi-star-outline" data-value="4"></i>
													<i class="item-rating pointer zmdi zmdi-star-outline" data-value="5"></i>

													<input type="number" name="Rating" id="RatingValue" class="d-none">
												</span>
											</div>



											<div class="row p-b-25">
												<div class="col-12 p-b-5 form-group">
													<label class="stext-102 cl3" for="Content">Your Review</label>
													<textarea class="size-110 bor8 stext-102 cl2 p-lr-20 p-tb-10 form-control" for="Content" id="Content" name="Content"></textarea>
												</div>

												<div class="col-sm-6 p-b-5 form-group">
													<label class="stext-102 cl3" for="UserName">User Name</label>
													<input class="size-111 bor8 stext-102 cl2 p-lr-20 form-control" for="UserName" id="UserName" type="text" name="UserName">
												</div>

												@* <div class="col-sm-6 p-b-5">
												<label class="stext-102 cl3" for="email">Email</label>
												<input class="size-111 bor8 stext-102 cl2 p-lr-20" id="email" type="text" name="email">
											</div> *@
											</div>

											<button type="submit" class="flex-c-m stext-101 cl0 size-112 bg7 bor11 hov-btn3 p-lr-15 trans-04 m-b-10">
												Submit
											</button>
										</form>
									}
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="bg6 flex-c-m flex-w size-302 m-t-73 p-tb-15">
		<span class="stext-107 cl6 p-lr-25">
			SKU: JAK-01
		</span>

		<span class="stext-107 cl6 p-lr-25">
			Categories: @Model.Product.Category.Name
		</span>
	</div>


	<!-- Delete Confirmation Modal -->
	<div class="modal fade mt-5" id="deleteModal" tabindex="-1">
		<div class="modal-dialog modal-dialog-centered" style="margin-top:80px">
			<div class="modal-content">

				<div class="modal-header bg-danger text-white">
					<h5 class="modal-title">Delete Product</h5>
					<button type="button" class="btn-close btn-close-white"
							data-bs-dismiss="modal"></button>
				</div>

				<div class="modal-body text-center">
					<p class="fw-semibold">
						Are you sure you want to delete this product
						from your system?
					</p>

					<h6 class="text-danger">@Model.Product.Name</h6>
				</div>

				<div class="modal-footer">

					<!-- NO -->
					<button type="button"
							class="btn btn-secondary"
							data-bs-dismiss="modal">
						No
					</button>

					<!-- YES -->
					<form asp-controller="Product"
						  asp-action="DeleteConfirmed"
						  asp-route-id="@Model.Product.Id"
						  method="post">

						<button type="submit"
								class="btn btn-danger">
							Yes, Delete
						</button>

					</form>
				</div>
			</div>
		</div>
	</div>

</section>


@section Scripts{

	<script>
		$("#reviewForm").on('submit', function (event) {
			event.preventDefault();

			var rating = $("#RatingValue").val();
			var content = $("#Content").val();
			var userName = $("#UserName").val();
			var productId = @Model.Product.Id;

			console.log(userName, content, rating, productId);

			if (!rating) {
				alert("Please select a rating");
				return;
			}

			$.ajax({
				url: '@Url.Action("AddReview", "Product")',
				type: 'POST',
				contentType: 'application/json',
				data: JSON.stringify({
					UserName: userName,
					Content: content,
					Rating: parseInt(rating),
					ProductId: productId
				}),
				success: function (response) {
					$('#reviewForm')[0].reset();
					$('#Rating').val("");

					$('#reviewSection').append(
					`
					<div class="flex-w flex-t p-b-68 review-card ">
						<div class="wrap-pic-s size-109 bor0 of-hidden m-r-18 m-t-6">
							<img src="${response.userImage}" alt="AVATAR">
						</div>

						<div class="size-207">
							<div class="flex-w flex-sb-m p-b-17">
								<span class="mtext-107 cl2 p-r-20">
									${response.username}
								</span>

								<span class="fs-20 cl11">
									${'★'.repeat(response.rating)}${'☆'.repeat(5 - response.rating)}
								</span>
							</div>
							<p class="stext-102 cl6">
								${response.content}
							</p>
						</div>
					</div>

					`
					);
					console.log("Success")
				},
				error: function(err) {
					console.log(err);
				}
					})

				});
	</script>
		
}
	
