@model List<Nadixa.Web.Models.ViewModels.WishlistItemViewModel>


@{
    ViewData["Title"] = "Your Wishlist";
}

<style>
    .wishlist-page {
        margin-top: 80px;
    }

    /* Header */
    .wishlist-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .wishlist-header h3 {
            font-weight: 600;
        }

        .wishlist-header span {
            color: #777;
        }

    /* Card */
    .wishlist-card {
        position: relative;
        background: #fff;
        border-radius: 15px;
        overflow: hidden;
        transition: 0.3s;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

        .wishlist-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        }

    /* Image */
    .wishlist-img {
        overflow: hidden;
    }

        .wishlist-img img {
            width: 100%;
            height: 230px;
            object-fit: cover;
            transition: 0.4s;
        }

    .wishlist-card:hover img {
        transform: scale(1.08);
    }

    /* Heart */
    .heart-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        background: #fff;
        border: none;
        border-radius: 50%;
        padding: 10px;
        cursor: pointer;
        z-index: 2;
        transition: 0.3s;
    }

        .heart-btn i {
            font-size: 18px;
            color: #999;
            transition: 0.3s;
        }

        .heart-btn.js-addedwish-detail i {
            color: #717fe0;
        }

        .heart-btn:hover {
            transform: scale(1.2);
        }

    /* Content */
    .wishlist-content {
        padding: 15px;
        text-align: center;
    }

        .wishlist-content h6 {
            font-weight: 500;
            margin-bottom: 8px;
        }

    .price {
        display: block;
        color: #717fe0;
        font-weight: 600;
        margin-bottom: 12px;
    }

    /* Button */
    .btn-add-cart {
        width: 100%;
        border: none;
        background: #717fe0;
        color: white;
        padding: 8px;
        border-radius: 25px;
        transition: 0.3s;
    }

        .btn-add-cart:hover {
            background: #333;
        }

    /* Empty */
    .empty-wishlist {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-wishlist i {
            font-size: 60px;
            color: #ddd;
        }

        .empty-wishlist h4 {
            margin-top: 15px;
        }

    .btn-shop {
        display: inline-block;
        margin-top: 15px;
        padding: 10px 20px;
        background: #717fe0;
        color: white;
        border-radius: 25px;
    }
