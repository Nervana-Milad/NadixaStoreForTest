<div class="container wishlist-page">
    <div class="wishlist-header">
        <h3>My Wishlist</h3>
        <span>@Model.Count item(s)</span>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-wishlist">
            <i class="zmdi zmdi-favorite-outline"></i>
            <h4>Your wishlist is empty</h4>
            <p>Start adding products you love ❤️</p>
            <a asp-controller="Product" asp-action="Index" class="btn-shop">
                Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 wishlist-item">
                    <div class="wishlist-card">

                        <!-- ❤️ Heart -->
                        <button class="js-addwish-detail heart-btn js-addedwish-detail"
                                data-product-id="@item.ProductId"
                                data-product-name="@item.ProductName">
                            <i class="zmdi zmdi-favorite"></i>
                        </button>

                        <!-- Image -->
                        <div class="wishlist-img">
                            <img src="@item.MainImageUrl" alt="@item.ProductName">
                        </div>

                        <!-- Content -->
                        <div class="wishlist-content">
                            <h6>@item.ProductName</h6>
                            <span class="price">L.E. @item.Price</span>

                            <button class="btn-add-cart move-to-cart"
                                    data-product-id="@item.ProductId">
                                Add to Cart
                            </button>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>
