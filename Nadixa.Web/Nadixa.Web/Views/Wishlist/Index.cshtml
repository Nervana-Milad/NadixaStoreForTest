@model List<Nadixa.Web.Models.ViewModels.WishlistItemViewModel>


@{
    ViewData["Title"] = "Your Wishlist";
}

<style>
    .product-card {
        position: relative;
        border: none;
        border-radius: 12px;
        overflow: hidden;
        transition: 0.3s;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .product-card img {
            height: 250px;
            object-fit: cover;
        }

    /* ❤️ Heart */
    .wishlist-heart {
        position: absolute;
        top: 10px;
        right: 10px;
        background: white;
        border: none;
        border-radius: 50%;
        padding: 8px;
        cursor: pointer;
        transition: 0.3s;
    }

        .wishlist-heart.active {
            color: rgb(113, 127, 224);
            ;
        }

        .wishlist-heart:hover {
            transform: scale(1.2);
        }

    /* Remove animation */
    .wishlist-item.removing {
        opacity: 0;
        transform: scale(0.8);
        transition: 0.3s;
    }

    .wishlist-btn {
        background: white;
        border: none;
        cursor: pointer;
        transition: 0.3s;
    }

        .wishlist-btn i {
            color: #999;
            font-size: 20px;
        }

        .wishlist-btn.active i {
            color: red;
            transform: scale(1.2);
        }

        .wishlist-btn:hover i {
            color: red;
        }
</style>

<div class="container" style="margin-top:80px">
    <div class="p-b-10">
        <h3 class="ltext-103 cl5">
            My Wishlist
        </h3>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center p-5">
            <h4>No items in your Wishlist</h4>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-3">
                Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach(var item in Model)
            {
                <div class="col-md-3 col-sm-6 mb-4 wishlist-item">
                    <div class="card product-card">
                        <button class="wishlist-heart active" data-product-id="@item.ProductId" data-product-name="@item.ProductName"><i class="zmdi zmdi-favorite"></i></button>
                        <img src="@item.MainImageUrl" class="card-img-top" />
                        <div class="card-body text-center">
                            <h6>@item.ProductName</h6>
                            <p class="text-center">L.E. @item.Price</p>
                            <button class="btn btn-success btn-sm move-to-cart" data-product-id="@item.ProductId">Add to Cart</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>