@model List<Nadixa.Application.DTOS.WishlistItemDto>

@{
    ViewData["Title"] = "Your Wishlist";
}

<style>
    .wishlist-page {
        margin-top: 90px;
    }

    .wishlist-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 40px;
        padding-bottom: 20px;
        border-bottom: 1px solid #ebebeb;
    }

        .wishlist-header h3 {
            font-weight: 700;
            color: #222;
            margin: 0;
        }

        .wishlist-header span {
            font-size: 14px;
            color: #999;
        }

    .wishlist-card {
        position: relative;
    }

    .wishlist-pic {
        position: relative;
        overflow: hidden;
        border-radius: 4px;
    }

        .wishlist-pic img {
            width: 100%;
            height: 270px;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

    .wishlist-card:hover .wishlist-pic img {
        transform: scale(1.06);
    }

    .wishlist-remove-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        border: none;
        border-radius: 50%;
        box-shadow: 0 2px 8px rgba(0,0,0,.12);
        cursor: pointer;
        z-index: 2;
        transition: 0.25s;
    }

        .wishlist-remove-btn i {
            font-size: 16px;
            color: #717fe0;
        }

        .wishlist-remove-btn:hover {
            background: #717fe0;
        }

            .wishlist-remove-btn:hover i {
                color: #fff;
            }

    .wishlist-txt {
        padding-top: 14px;
    }

        .wishlist-txt .name {
            display: block;
            font-size: 15px;
            color: #222;
            margin-bottom: 6px;
            text-decoration: none;
            transition: 0.2s;
        }

            .wishlist-txt .name:hover {
                color: #717fe0;
            }

        .wishlist-txt .price {
            display: block;
            font-size: 16px;
            font-weight: 600;
            color: #222;
            margin-bottom: 14px;
        }

    /* Empty state */
    .empty-wishlist {
        text-align: center;
        padding: 90px 20px;
    }

        .empty-wishlist i {
            font-size: 56px;
            color: #e2e2e2;
        }

        .empty-wishlist h4 {
            margin-top: 18px;
            font-weight: 700;
            color: #222;
        }

        .empty-wishlist p {
            color: #999;
            margin-bottom: 24px;
        }

    .btn-shop {
        display: inline-block;
        padding: 12px 28px;
        background: #222;
        color: #fff;
        border-radius: 30px;
        font-size: 13px;
        letter-spacing: .5px;
        text-transform: uppercase;
        text-decoration: none;
        transition: 0.25s;
    }

        .btn-shop:hover {
            background: #717fe0;
            color: #fff;
        }

    .wishlist-item.removing {
        opacity: 0;
        transform: scale(0.92);
        transition: 0.3s;
    }
</style>

<div class="container wishlist-page">
    <div class="wishlist-header">
        <h3>My Wishlist</h3>
        <span>@Model.Count item(s)</span>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-wishlist">
            <i class="zmdi zmdi-favorite-outline"></i>
            <h4>Your wishlist is empty</h4>
            <p>Start adding products you love ❤️</p>
            <a asp-controller="Product" asp-action="Index" class="btn-shop">
                Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 wishlist-item">
                    <div class="wishlist-card">

                        <div class="wishlist-pic">
                            <button class="wishlist-remove-btn js-addwish-detail js-addedwish-detail"
                                    data-product-id="@item.ProductId"
                                    data-product-name="@item.ProductName"
                                    title="Remove from wishlist">
                                <i class="zmdi zmdi-favorite"></i>
                            </button>

                            <img src="@item.MainImageUrl" alt="@item.ProductName">
                        </div>

                        <div class="wishlist-txt">
                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId" class="name">
                                @item.ProductName
                            </a>
                            <span class="price">L.E. @item.Price</span>

                            <div class="cart-controls" data-product-id="@item.ProductId">
                                @if (item.CartQuantity > 0)
                                {
                                    <div class="cart-counter">
                                        <button class="cart-minus" data-product-id="@item.ProductId">
                                            @(item.CartQuantity == 1 ? "🗑" : "-")
                                        </button>
                                        <span class="cart-qty">@item.CartQuantity in cart</span>
                                        <button class="cart-plus"
                                                data-product-id="@item.ProductId"
                                                @(item.CartQuantity >= item.StockQuantity ? "disabled" : "")>
                                            +
                                        </button>
                                    </div>
                                }
                                else if (item.StockQuantity > 0)
                                {
                                    <button class="btn-addcart-card js-addcart-detail hov-btn3"
                                            data-product-id="@item.ProductId">
                                        Add to Cart
                                    </button>
                                }
                                else
                                {
                                    <button type="button" disabled class="btn-addcart-card" style="opacity:.6; cursor:not-allowed;">
                                        Out of Stock
                                    </button>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>