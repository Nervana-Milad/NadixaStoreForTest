@using Nadixa.Core.Entities
@model List<Coupon>
@{
    ViewData["Title"] = "إدارة الكوبونات";
}

<div class="container order-section">

    <div class="order-card">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="order-title">أكواد الخصم</h2>
            <a asp-action="Create" class="btn btn-dark">+ كوبون جديد</a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>الكود</th>
                    <th>الخصم</th>
                    <th>الحد الأدنى</th>
                    <th>الاستخدام</th>
                    <th>من - إلى</th>
                    <th>الحالة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var coupon in Model)
                {
                    <tr>
                        <td><code>@coupon.Code</code></td>
                        <td>
                            @(coupon.DiscountType == CouponDiscountType.Percentage
                                ? $"{coupon.Value}%"
                                : $"L.E. {coupon.Value}")
                        </td>
                        <td>@(coupon.MinOrderAmount.HasValue ? $"L.E. {coupon.MinOrderAmount}" : "-")</td>
                        <td>
                            @(coupon.MaxUsagePerUser.HasValue ? $"{coupon.MaxUsagePerUser} / يوزر" : "بلا حد")
                            @if (coupon.FirstOrderOnly)
                            {
                                <span class="status-badge status-pending">أول أوردر</span>
                            }
                        </td>
                        <td>@coupon.StartDate.ToString("dd MMM") - @coupon.EndDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (coupon.IsCurrentlyValid)
                            {
                                <span class="status-badge status-confirmed">شغال</span>
                            }
                            else
                            {
                                <span class="status-badge status-cancelled">متوقف</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@coupon.Id" class="btn btn-sm btn-outline-dark">تعديل</a>

                                <form asp-action="ToggleActive" asp-route-id="@coupon.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        @(coupon.IsActive ? "إيقاف" : "تفعيل")
                                    </button>
                                </form>

                                <form asp-action="Delete" asp-route-id="@coupon.Id" method="post"
                                      onsubmit="return confirm('متأكدة من الحذف؟');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>
