@using Nadixa.Core.Entities
@model List<Coupon>
@{
    ViewData["Title"] = "Manage Coupons";
}
<div class="container order-section">
    <div class="order-card">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="order-title">Discount Codes</h2>
        
            <div class="flex-c-m stext-106 cl6 size-105 bor4 pointer hov-btn3 trans-04 m-tb-4 px-3" style="background-color:#6c7ae0; color:white">
                <i class="icon-search cl2 m-r-6 fs-15 trans-04 zmdi zmdi-plus text-white"></i>
                <a class="text-white" asp-action="Create">New Coupon</a>
            </div>
        </div>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Discount</th>
                    <th>Min. Order</th>
                    <th>Usage</th>
                    <th>From - To</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var coupon in Model)
                {
                    <tr>
                        <td><code>@coupon.Code</code></td>
                        <td>
                            @(coupon.DiscountType == CouponDiscountType.Percentage
                                ? $"{coupon.Value}%"
                                : $"L.E. {coupon.Value}")
                        </td>
                        <td>@(coupon.MinOrderAmount.HasValue ? $"L.E. {coupon.MinOrderAmount}" : "-")</td>
                        <td>
                            @(coupon.MaxUsagePerUser.HasValue ? $"{coupon.MaxUsagePerUser} / user" : "Unlimited")
                            @if (coupon.FirstOrderOnly)
                            {
                                <span class="status-badge status-pending">First Order</span>
                            }
                        </td>
                        <td>@coupon.StartDate.ToString("dd MMM") - @coupon.EndDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (coupon.IsCurrentlyValid)
                            {
                                <span class="status-badge status-confirmed">Active</span>
                            }
                            else
                            {
                                <span class="status-badge status-cancelled">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <a asp-action="Edit" asp-route-id="@coupon.Id"
                                   class="btn rounded-pill flex-c-m stext-106 cl6 bor4 pointer hov-btn3 trans-04">
                                    Edit
                                </a>

                                <form asp-action="ToggleActive" asp-route-id="@coupon.Id" method="post">
                                    <button type="submit"
                                            class="btn px-3 hov-btn3 rounded-pill shadow" style="background-color:#6c7ae0; color:white;">
                                        @(coupon.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>

                                <button type="button"
                                        class="btn btn-danger hov-btn3 px-3 rounded-pill shadow-sm delete-coupon-btn"
                                        data-coupon-id="@coupon.Id"
                                        data-coupon-name="@coupon.Code">
                                    Delete
                                </button>
                            </div>
                            @* <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@coupon.Id" class="btn btn-sm btn-outline-dark">Edit</a>
                                <form asp-action="ToggleActive" asp-route-id="@coupon.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        @(coupon.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@coupon.Id" method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div> *@
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<form id="deleteCouponForm" asp-action="Delete" method="post"></form>