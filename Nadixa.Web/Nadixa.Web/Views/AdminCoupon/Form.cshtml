@using Nadixa.Core.Entities
@model Nadixa.Web.Models.ViewModels.CouponFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "New Coupon" : "Edit Coupon";
}

<div class="container order-section">

    <div class="order-card">

        <h2 class="order-title mb-4">@ViewData["Title"]</h2>

        <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="row">

                <div class="col-md-4 mb-3">
                    <label class="form-label">Code</label>
                    <input asp-for="Code" class="form-control" style="text-transform:uppercase" placeholder="WELCOME10" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Discount Type</label>
                    <select asp-for="DiscountType" class="form-control">
                        <option value="@CouponDiscountType.Percentage">Percentage %</option>
                        <option value="@CouponDiscountType.FixedAmount">Fixed Amount</option>
                    </select>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Value</label>
                    <input asp-for="Value" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Value" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Minimum Order Amount (optional)</label>
                    <input asp-for="MinOrderAmount" type="number" step="0.01" class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Max Discount Amount (for percentage type)</label>
                    <input asp-for="MaxDiscountAmount" type="number" step="0.01" class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Max Total Usage</label>
                    <input asp-for="MaxTotalUsage" type="number" class="form-control" placeholder="Unlimited" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Max Usage Per User</label>
                    <input asp-for="MaxUsagePerUser" type="number" class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Start Date</label>
                    <input asp-for="StartDate" type="datetime-local" class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">End Date</label>
                    <input asp-for="EndDate" type="datetime-local" class="form-control" />
                </div>

                <div class="col-md-3 mb-3 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="FirstOrderOnly" class="form-check-input" />
                        <label class="form-check-label">First Order Only</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label class="form-check-label">Active</label>
                    </div>
                </div>

            </div>

            
            <div class="d-flex align-items-center gap-3 mt-3">
                <button type="submit"
                        class="btn px-4 hov-btn3 rounded-pill shadow" style="background-color:#6c7ae0; color:white;">
                    <i class="bi bi-check-circle me-2"></i> Save
                </button>

                <a asp-action="Index"
                   class="btn rounded-pill flex-c-m stext-106 cl6 bor4 pointer hov-btn3 trans-04 ml-3">
                    Cancel
                </a>
            </div>

        </form>

    </div>

</div>
