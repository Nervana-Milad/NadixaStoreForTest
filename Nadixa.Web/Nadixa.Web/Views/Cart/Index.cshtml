@model Nadixa.Web.Models.ViewModels.CartIndexViewModel

@{
	ViewData["Title"] = "Shopping Cart";
	bool hasStockIssues = Model.Items.Any(i => i.StockQuantity <= 0 || i.Quantity > i.StockQuantity);
}

<style>
	.row-out-of-stock {
		background-color: #fff5f5;
		opacity: 0.85;
	}

	/* تضييق المسافة بين المنتجات في الجدول */
	.table-shopping-cart .table_row td {
		padding-top: 12px !important;
		padding-bottom: 12px !important;
	}

	.table-shopping-cart .how-itemcart1 {
		margin: 0 !important;
	}

	.table-shopping-cart .how-itemcart1 img {
		max-height: 70px;
		width: auto;
	}
</style>
<!-- breadcrumb -->
<div class="container" style="margin-top:80px">
	<div class="bread-crumb flex-w p-l-25 p-r-15 p-t-30 p-b-30 p-lr-0-lg">
		<a href="index.html" class="stext-109 cl8 hov-cl1 trans-04">
			Home
			<i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
		</a>

		<span class="stext-109 cl4">
			Shoping Cart
		</span>
	</div>
</div>

@if (hasStockIssues)
{
	<div class="container" id="stockWarningContainer">
		<div class="alert alert-warning d-flex align-items-center" role="alert" style="border-radius:8px;">
			<i class="zmdi zmdi-alert-triangle fs-20 mr-2"></i>
			<div>
				Some items in your cart are unavailable or exceed the available stock.
				Please update the quantity or remove the item before proceeding to checkout.
			</div>
		</div>
	</div>
}

<!-- Shoping Cart -->
<form class="bg0 p-t-75 p-b-85" asp-controller="Cart" asp-action="UpdateCart" method="post">
	<div class="container">
		<div class="row">
			<div class="col-lg-10 col-xl-7 m-lr-auto m-b-50">
				<div class="m-l-25 m-r--38 m-lr-0-xl">
					<div class="wrap-table-shopping-cart">
						<table class="table-shopping-cart">
							<tr class="table_head">
								<th class="column-1">Product</th>
								<th class="column-2"></th>
								<th class="column-3">Price</th>
								<th class="column-4">Quantity</th>
								<th class="column-5">Total</th>
								<th class="column-6"></th>

							</tr>
							@foreach (var item in Model.Items)
							{
								bool isOutOfStock = item.StockQuantity <= 0;
								bool isPartialShortage = !isOutOfStock && item.Quantity > item.StockQuantity;
								bool rowHasIssue = isOutOfStock || isPartialShortage;


								<tr class="table_row @(isOutOfStock ? "row-out-of-stock" : "")"
									data-stock-issue="@rowHasIssue.ToString().ToLower()">
									<td class="column-1">
										<div class="how-itemcart1" style="position:relative;">
											@if (!string.IsNullOrEmpty(item.PromoBadgeText))
											{
												<span style="position:absolute; top:-6px; left:-6px; z-index:5; background-color:@(item.PromoBadgeColorHex ?? "#FF3B30"); color:#fff; font-size:10px; font-weight:700; padding:3px 8px; border-radius:20px;">
													@item.PromoBadgeText
												</span>
											}
											<img src="@item.MainImageUrl" alt="IMG">
										</div>
									</td>
									<td class="column-2">
										@item.ProductName

										@if (isOutOfStock)
										{
											<div class="text-danger small mt-1">
												<i class="zmdi zmdi-alert-circle-o"></i> This item is out of stock
											</div>
										}
										else if (isPartialShortage)
										{
											<div class="text-warning small mt-1">
												<i class="zmdi zmdi-alert-triangle"></i> Only @item.StockQuantity available
											</div>
										}
									</td>
									<td class="column-3">
										@if (item.DiscountedUnitPrice != null && item.DiscountedUnitPrice < item.Price)
										{
											<div>
												<span style="color:#e74c3c; font-weight:700;">L.E. @item.DiscountedUnitPrice.Value.ToString("N2")</span>
												<div style="text-decoration:line-through; color:#999; font-size:12px;">L.E. @item.Price.ToString("N2")</div>
											</div>
										}
										else
										{
											@:L.E. @item.Price
										}
									</td>
									<td class="column-4">

										<div class="wrap-num-product flex-w m-r-20 m-tb-10 my-3">

											<div class="btn-num-product-down cl8 hov-btn3 trans-04 flex-c-m @(item.StockQuantity <= 0 ? "disabled-btn" : "")">
												<i class="fs-16 zmdi zmdi-minus"></i>
											</div>

											<input class="mtext-104 cl3 txt-center num-product"
												   type="number"
												   name="quantities[@item.ProductId]"
												   value="@(item.StockQuantity > 0 ? item.Quantity : 0)"
												   min="@(item.StockQuantity > 0 ? 1 : 0)"
												   max="@item.StockQuantity"
												   @(item.StockQuantity <= 0 ? "readonly" : "")>

											<div class="btn-num-product-up cl8 hov-btn3 trans-04 flex-c-m @(item.StockQuantity <= 0 ? "disabled-btn" : "")">
												<i class="fs-16 zmdi zmdi-plus"></i>
											</div>

										</div>
									</td>
									<td class="column-5">L.E. @item.TotalPrice</td>
									<td class="column-6">
										<button class="remove-item-btn text-danger fs-20"
												data-product-id="@item.ProductId"
												type="button">
											<i class="bi bi-trash"></i>
										</button>
									</td>

								</tr>
							}
						</table>
					</div>

					<div class="flex-w flex-sb-m bor15 p-t-18 p-b-15 p-lr-40 p-lr-15-sm">
						<div class="flex-w flex-m m-r-20 m-tb-5">
							<input class="stext-104 cl2 plh4 size-117 bor13 p-lr-20 m-r-10 m-tb-5"
								   type="text"
								   name="couponCode"
								   value="@Model.CouponCode"
								   placeholder="Coupon Code">

							<button type="submit"
									formaction="@Url.Action("ApplyCoupon", "Cart")"
									class="flex-c-m stext-101 cl2 size-118 bg8 bor13 hov-btn3 p-lr-15 trans-04 pointer m-tb-5"
									style="border:none;">
								Apply coupon
							</button>
						</div>

						<button type="submit" class="flex-c-m stext-101 cl2 size-119 bg8 bor13 hov-btn3 p-lr-15 trans-04 pointer m-tb-10">
							Update Cart
						</button>
					</div>

					@if (!string.IsNullOrEmpty(Model.Pricing.CouponError))
					{
						<div class="text-danger p-lr-40 p-lr-15-sm" style="font-size:14px;">@Model.Pricing.CouponError</div>
					}
					@if (!string.IsNullOrEmpty(Model.CouponCode) && string.IsNullOrEmpty(Model.Pricing.CouponError) && Model.Pricing.CouponDiscount > 0)
					{
						<div class="p-lr-40 p-lr-15-sm" style="font-size:14px; color:#2ecc71;">
							Coupon "@Model.CouponCode" applied — you saved L.E. @Model.Pricing.CouponDiscount.ToString("N2")
							<button type="submit" formaction="@Url.Action("RemoveCoupon", "Cart")" class="btn btn-sm btn-link text-danger p-0">Remove</button>
						</div>
					}
				</div>
			</div>

			<div class="col-sm-10 col-lg-7 col-xl-5 m-lr-auto m-b-50">
				<div class="bor10 p-lr-40 p-t-30 p-b-40 m-l-63 m-r-40 m-lr-0-xl p-lr-15-sm">
					<h4 class="mtext-109 cl2 p-b-30">
						Order Summary
					</h4>

					<div class="flex-w flex-t bor12 p-b-13">
						<div class="size-208">
							<span class="stext-110 cl2">
								Products Subtotal:
							</span>
						</div>

						<div class="size-209">
							<span class="mtext-110 cl2">
								L.E. @Model.Pricing.SubTotal.ToString("N2")
							</span>
						</div>
					</div>

					@{
						var totalDiscount = Model.Pricing.ProductsDiscountTotal
										  + Model.Pricing.BundleDiscountTotal
										  + Model.Pricing.CouponDiscount;
					}
					@if (totalDiscount > 0)
					{
						<div class="flex-w flex-t bor12 p-b-13">
							<div class="size-208">
								<span class="stext-110 cl2">
									You Saved:
								</span>
							</div>

							<div class="size-209">
								<span class="mtext-110" style="color:#2ecc71;">
									- L.E. @totalDiscount.ToString("N2")
								</span>
							</div>
						</div>

						@if (Model.Pricing.AppliedPromotions.Any())
						{
							<div class="p-b-13" style="font-size:13px; color:#888;">
								@foreach (var promo in Model.Pricing.AppliedPromotions)
								{
									<div>@(promo.BadgeText ?? promo.Name): - L.E. @promo.DiscountAmount.ToString("N2")</div>
								}
							</div>
						}
					}

					<div class="flex-w flex-t bor12 p-t-15 p-b-30">
						<div class="size-208 w-full-ssm">
							<span class="stext-110 cl2">
								Shipping:
							</span>
						</div>

						<div class="size-209 p-r-18 p-r-0-sm w-full-ssm">
							<p class="stext-111 cl6 p-t-2">
								@(Model.Pricing.ShippingFee == 0
									? "Free shipping applied to your order."
									: $"Standard shipping fee: L.E. {Model.Pricing.ShippingFee:N2}")
							</p>

							<div class="p-t-15">
								<div class="flex-w flex-t p-t-27 p-b-33">
									<div class="size-208">
										<span class="mtext-101 cl2">
											Total:
										</span>
									</div>

									<div class="size-209 p-t-1">
										<span class="mtext-110 cl2">
											L.E. @Model.Pricing.GrandTotal.ToString("N2")
										</span>
									</div>
								</div>

								<a asp-controller="Order"
								   asp-action="Checkout"
								   id="checkoutBtn"
								   class="btn hov-btn3 btn-dark @(hasStockIssues ? "disabled" : "")"
								   style="@(hasStockIssues ? "pointer-events:none; opacity:0.5; cursor:not-allowed;" : "")"
								   tabindex="@(hasStockIssues ? "-1" : "0")"
								   aria-disabled="@hasStockIssues.ToString().ToLower()">
									Proceed To Checkout
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>
